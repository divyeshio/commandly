{
  "$schema": "https://commandly.divyeshio.in/specification/tool.json",
  "binaryName": "shuffledns",
  "displayName": "ShuffleDNS",
  "info": {
    "description": "MassDNS wrapper written in go to enumerate valid subdomains using active bruteforce as well as resolve subdomains with wildcard filtering and easy input-output support.",
    "version": "1.2.1",
    "url": "https://github.com/projectdiscovery/shuffledns"
  },
  "commands": [],
  "parameters": [
    {
      "displayName": "Domain",
      "description": "Domain to find or resolve subdomains for",
      "parameterType": "Option",
      "dataType": "String",
      "isRepeatable": true,
      "sortOrder": 1,
      "key": "-domain",
      "aliases": [
        "-d"
      ]
    },
    {
      "displayName": "Auto Domain",
      "description": "Automatically extract root domains",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 2,
      "key": "-auto-domain",
      "aliases": [
        "-ad"
      ]
    },
    {
      "displayName": "List",
      "description": "File containing list of subdomains to resolve",
      "parameterType": "Option",
      "dataType": "String",
      "sortOrder": 3,
      "key": "-list",
      "aliases": [
        "-l"
      ]
    },
    {
      "displayName": "Wordlist",
      "description": "File containing words to bruteforce for domain",
      "parameterType": "Option",
      "dataType": "String",
      "sortOrder": 4,
      "key": "-wordlist",
      "aliases": [
        "-w"
      ]
    },
    {
      "displayName": "Resolver",
      "description": "File containing list of resolvers for enumeration",
      "parameterType": "Option",
      "dataType": "String",
      "sortOrder": 5,
      "key": "-resolver",
      "aliases": [
        "-r"
      ]
    },
    {
      "displayName": "Trusted Resolver",
      "description": "File containing list of trusted resolvers",
      "parameterType": "Option",
      "dataType": "String",
      "sortOrder": 6,
      "key": "-trusted-resolver",
      "aliases": [
        "-tr"
      ]
    },
    {
      "displayName": "Raw Input",
      "description": "Validate raw full massdns output",
      "parameterType": "Option",
      "dataType": "String",
      "sortOrder": 7,
      "key": "-raw-input",
      "aliases": [
        "-ri"
      ]
    },
    {
      "displayName": "Mode",
      "description": "Execution mode (bruteforce, resolve, filter)",
      "parameterType": "Option",
      "dataType": "Enum",
      "sortOrder": 8,
      "key": "-mode",
      "enum": {
        "values": [
          {
            "value": "bruteforce",
            "displayName": "Bruteforce"
          },
          {
            "value": "resolve",
            "displayName": "Resolve"
          },
          {
            "value": "filter",
            "displayName": "Filter"
          }
        ]
      }
    },
    {
      "displayName": "Threads",
      "description": "Number of concurrent massdns resolves (default 10000)",
      "parameterType": "Option",
      "dataType": "Number",
      "sortOrder": 9,
      "key": "-t"
    },
    {
      "displayName": "Update",
      "description": "update shuffledns to latest version",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 10,
      "key": "-update",
      "aliases": [
        "-up"
      ]
    },
    {
      "displayName": "Disable Update Check",
      "description": "disable automatic shuffledns update check",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 11,
      "key": "-disable-update-check",
      "aliases": [
        "-duc"
      ]
    },
    {
      "displayName": "Output",
      "description": "File to write output to (optional)",
      "parameterType": "Option",
      "dataType": "String",
      "sortOrder": 12,
      "key": "-output",
      "aliases": [
        "-o"
      ]
    },
    {
      "displayName": "JSON Output",
      "description": "Make output format as ndjson",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 13,
      "key": "-json",
      "aliases": [
        "-j"
      ]
    },
    {
      "displayName": "Wildcard Output",
      "description": "Dump wildcard ips to output file",
      "parameterType": "Option",
      "dataType": "String",
      "sortOrder": 14,
      "key": "-wildcard-output",
      "aliases": [
        "-wo"
      ]
    },
    {
      "displayName": "Massdns",
      "description": "Path to the massdns binary",
      "parameterType": "Option",
      "dataType": "String",
      "sortOrder": 15,
      "key": "-massdns",
      "aliases": [
        "-m"
      ]
    },
    {
      "displayName": "Massdns Cmd",
      "description": "Optional massdns commands to run (example '-i 10')",
      "parameterType": "Option",
      "dataType": "String",
      "sortOrder": 16,
      "key": "-massdns-cmd",
      "aliases": [
        "-mcmd"
      ]
    },
    {
      "displayName": "Directory",
      "description": "Temporary directory for enumeration",
      "parameterType": "Option",
      "dataType": "String",
      "sortOrder": 17,
      "key": "-directory"
    },
    {
      "displayName": "Retries",
      "description": "Number of retries for dns enumeration (default 5)",
      "parameterType": "Option",
      "dataType": "Number",
      "sortOrder": 18,
      "key": "-retries"
    },
    {
      "displayName": "Strict Wildcard",
      "description": "Perform wildcard check on all found subdomains",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 19,
      "key": "-strict-wildcard",
      "aliases": [
        "-sw"
      ]
    },
    {
      "displayName": "Wildcard Threads",
      "description": "Number of concurrent wildcard checks (default 250)",
      "parameterType": "Option",
      "dataType": "Number",
      "sortOrder": 20,
      "key": "-wt"
    },
    {
      "displayName": "Silent",
      "description": "Show only subdomains in output",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 21,
      "key": "-silent"
    },
    {
      "displayName": "Version",
      "description": "Show version of shuffledns",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 22,
      "key": "-version"
    },
    {
      "displayName": "Verbose",
      "description": "Show Verbose output",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 23,
      "key": "-v"
    },
    {
      "displayName": "No Color",
      "description": "Don't Use colors in output",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 24,
      "key": "-no-color",
      "aliases": [
        "-nc"
      ]
    }
  ],
  "installation": {
    "sources": [
      {
        "key": "go-install",
        "method": "package_manager",
        "manager": "go",
        "command": "go install -v github.com/projectdiscovery/shuffledns/cmd/shuffledns@latest",
        "url": "https://github.com/projectdiscovery/shuffledns#installation-instructions",
        "note": "Requires Go 1.24+ and the massdns binary at runtime."
      },
      {
        "key": "release-binary",
        "method": "binary",
        "command": "https://github.com/projectdiscovery/shuffledns/releases",
        "url": "https://github.com/projectdiscovery/shuffledns#installation-instructions",
        "note": "Release assets include OS-specific ZIP archives."
      }
    ]
  }
}
