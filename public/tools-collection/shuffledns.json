{
  "$schema": "https://commandly.divyeshio.in/specification/flat.json",
  "binaryName": "shuffledns",
  "displayName": "ShuffleDNS",
  "info": {
    "description": "MassDNS wrapper written in go to enumerate valid subdomains using active bruteforce as well as resolve subdomains with wildcard filtering and easy input-output support.",
    "version": "1.2.1",
    "url": "https://github.com/projectdiscovery/shuffledns"
  },
  "commands": [],
  "parameters": [
    {
      "name": "Domain",
      "description": "Domain to find or resolve subdomains for",
      "parameterType": "Option",
      "dataType": "String",
      "isRepeatable": true,
      "shortFlag": "-d",
      "longFlag": "-domain",
      "sortOrder": 1,
      "key": "domain"
    },
    {
      "name": "List",
      "description": "File containing list of subdomains to resolve",
      "parameterType": "Option",
      "dataType": "String",
      "shortFlag": "-l",
      "longFlag": "-list",
      "sortOrder": 2,
      "key": "list"
    },
    {
      "name": "Wordlist",
      "description": "File containing words to bruteforce for domain",
      "parameterType": "Option",
      "dataType": "String",
      "shortFlag": "-w",
      "longFlag": "-wordlist",
      "sortOrder": 3,
      "key": "wordlist"
    },
    {
      "name": "Resolver",
      "description": "File containing list of resolvers for enumeration",
      "parameterType": "Option",
      "dataType": "String",
      "shortFlag": "-r",
      "longFlag": "-resolver",
      "sortOrder": 4,
      "key": "resolver"
    },
    {
      "name": "Trusted Resolver",
      "description": "File containing list of trusted resolvers",
      "parameterType": "Option",
      "dataType": "String",
      "shortFlag": "-tr",
      "longFlag": "-trusted-resolver",
      "sortOrder": 5,
      "key": "trusted-resolver"
    },
    {
      "name": "Raw Input",
      "description": "Validate raw full massdns output",
      "parameterType": "Option",
      "dataType": "String",
      "shortFlag": "-ri",
      "longFlag": "-raw-input",
      "sortOrder": 6,
      "key": "raw-input"
    },
    {
      "name": "Mode",
      "description": "Execution mode (bruteforce, resolve, filter)",
      "parameterType": "Option",
      "dataType": "Enum",
      "longFlag": "-mode",
      "sortOrder": 7,
      "key": "mode",
      "enum": {
        "values": [
          {
            "value": "bruteforce",
            "displayName": "Bruteforce"
          },
          {
            "value": "resolve",
            "displayName": "Resolve"
          },
          {
            "value": "filter",
            "displayName": "Filter"
          }
        ]
      }
    },
    {
      "name": "Threads",
      "description": "Number of concurrent massdns resolves (default 10000)",
      "parameterType": "Option",
      "dataType": "Number",
      "shortFlag": "-t",
      "longFlag": "-t",
      "sortOrder": 8,
      "key": "t"
    },
    {
      "name": "Update",
      "description": "update shuffledns to latest version",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "shortFlag": "-up",
      "longFlag": "-update",
      "sortOrder": 9,
      "key": "update"
    },
    {
      "name": "Disable Update Check",
      "description": "disable automatic shuffledns update check",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "shortFlag": "-duc",
      "longFlag": "-disable-update-check",
      "sortOrder": 10,
      "key": "disable-update-check"
    },
    {
      "name": "Output",
      "description": "File to write output to (optional)",
      "parameterType": "Option",
      "dataType": "String",
      "shortFlag": "-o",
      "longFlag": "-output",
      "sortOrder": 11,
      "key": "output"
    },
    {
      "name": "JSON Output",
      "description": "Make output format as ndjson",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "shortFlag": "-j",
      "longFlag": "-json",
      "sortOrder": 12,
      "key": "json"
    },
    {
      "name": "Wildcard Output",
      "description": "Dump wildcard ips to output file",
      "parameterType": "Option",
      "dataType": "String",
      "shortFlag": "-wo",
      "longFlag": "-wildcard-output",
      "sortOrder": 13,
      "key": "wildcard-output"
    },
    {
      "name": "Massdns",
      "description": "Path to the massdns binary",
      "parameterType": "Option",
      "dataType": "String",
      "shortFlag": "-m",
      "longFlag": "-massdns",
      "sortOrder": 14,
      "key": "massdns"
    },
    {
      "name": "Massdns Cmd",
      "description": "Optional massdns commands to run (example '-i 10')",
      "parameterType": "Option",
      "dataType": "String",
      "shortFlag": "-mcmd",
      "longFlag": "-massdns-cmd",
      "sortOrder": 15,
      "key": "massdns-cmd"
    },
    {
      "name": "Directory",
      "description": "Temporary directory for enumeration",
      "parameterType": "Option",
      "dataType": "String",
      "longFlag": "-directory",
      "sortOrder": 16,
      "key": "directory"
    },
    {
      "name": "Retries",
      "description": "Number of retries for dns enumeration (default 5)",
      "parameterType": "Option",
      "dataType": "Number",
      "longFlag": "-retries",
      "sortOrder": 17,
      "key": "retries"
    },
    {
      "name": "Strict Wildcard",
      "description": "Perform wildcard check on all found subdomains",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "shortFlag": "-sw",
      "longFlag": "-strict-wildcard",
      "sortOrder": 18,
      "key": "strict-wildcard"
    },
    {
      "name": "Wildcard Threads",
      "description": "Number of concurrent wildcard checks (default 250)",
      "parameterType": "Option",
      "dataType": "Number",
      "longFlag": "-wt",
      "sortOrder": 19,
      "key": "wt"
    },
    {
      "name": "Silent",
      "description": "Show only subdomains in output",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "longFlag": "-silent",
      "sortOrder": 20,
      "key": "silent"
    },
    {
      "name": "Version",
      "description": "Show version of shuffledns",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "longFlag": "-version",
      "sortOrder": 21,
      "key": "version"
    },
    {
      "name": "Verbose",
      "description": "Show Verbose output",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "longFlag": "-v",
      "sortOrder": 22,
      "key": "v"
    },
    {
      "name": "No Color",
      "description": "Don't Use colors in output",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "shortFlag": "-nc",
      "longFlag": "-no-color",
      "sortOrder": 23,
      "key": "no-color"
    }
  ]
}
