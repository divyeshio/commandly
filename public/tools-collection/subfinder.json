{
  "$schema": "https://commandly.divyeshio.in/specification/tool.json",
  "binaryName": "subfinder",
  "displayName": "Subfinder",
  "info": {
    "description": "Subfinder is a subdomain discovery tool that discovers subdomains for websites by using passive online sources.",
    "version": "2.17.0",
    "url": "https://github.com/projectdiscovery/subfinder"
  },
  "commands": [],
  "parameters": [
    {
      "displayName": "Target Domain",
      "description": "Domains to find subdomains for",
      "parameterType": "Option",
      "dataType": "String",
      "arraySeparator": ",",
      "isRepeatable": true,
      "key": "-domain",
      "aliases": [
        "-d"
      ]
    },
    {
      "displayName": "Sources",
      "description": "Specific sources to use for discovery (-s crtsh,github). Use -ls to display all available sources.",
      "parameterType": "Option",
      "dataType": "String",
      "arraySeparator": ",",
      "isRepeatable": true,
      "key": "-sources",
      "aliases": [
        "-s"
      ]
    },
    {
      "displayName": "Recursive",
      "description": "Use only sources that can handle subdomains recursively rather than both recursive and non-recursive sources",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-recursive"
    },
    {
      "displayName": "Target Domains List",
      "description": "File containing list of domains for subdomain discovery",
      "parameterType": "Option",
      "dataType": "String",
      "key": "-list",
      "aliases": [
        "-dL"
      ]
    },
    {
      "displayName": "Output Directory",
      "description": "Directory to write output (-dL only)",
      "parameterType": "Option",
      "dataType": "String",
      "key": "-output-dir",
      "aliases": [
        "-oD"
      ]
    },
    {
      "displayName": "Timeout",
      "description": "Seconds to wait before timing out (default 30)",
      "parameterType": "Option",
      "dataType": "Number",
      "key": "-timeout"
    },
    {
      "displayName": "Resolvers File",
      "description": "File containing list of resolvers to use",
      "parameterType": "Option",
      "dataType": "String",
      "key": "-rlist",
      "aliases": [
        "-rL"
      ]
    },
    {
      "displayName": "Update",
      "description": "Update subfinder to latest version",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-update",
      "aliases": [
        "-up"
      ]
    },
    {
      "displayName": "Version",
      "description": "Show version of subfinder",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-version"
    },
    {
      "displayName": "Exclude IPs",
      "description": "Exclude IPs from the list of domains",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-exclude-ip",
      "aliases": [
        "-ei"
      ]
    },
    {
      "displayName": "Proxy",
      "description": "Http proxy to use with subfinder",
      "parameterType": "Option",
      "dataType": "String",
      "key": "-proxy"
    },
    {
      "displayName": "No Color",
      "description": "Disable color in output",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-no-color",
      "aliases": [
        "-nc"
      ]
    },
    {
      "displayName": "Match",
      "description": "Subdomain or list of subdomain to match (file or comma separated)",
      "parameterType": "Option",
      "dataType": "String",
      "arraySeparator": ",",
      "isRepeatable": true,
      "key": "-match",
      "aliases": [
        "-m"
      ]
    },
    {
      "displayName": "Include IP",
      "description": "Include host IP in output (-active only)",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-ip",
      "aliases": [
        "-oI"
      ]
    },
    {
      "displayName": "Active Domains Only",
      "description": "Display active subdomains only",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-active",
      "aliases": [
        "-nW"
      ]
    },
    {
      "displayName": "Rate Limits",
      "description": "Maximum number of http requests to send per second for providers in key=value format (-rls \"hackertarget=10/s,shodan=15/s\")",
      "parameterType": "Option",
      "dataType": "String",
      "keyValueSeparator": "=",
      "key": "-rls"
    },
    {
      "displayName": "Disable Update Check",
      "description": "Disable automatic subfinder update check",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-disable-update-check",
      "aliases": [
        "-duc"
      ]
    },
    {
      "displayName": "Collect Sources",
      "description": "Include all sources in the output (-json only)",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-collect-sources",
      "aliases": [
        "-cs"
      ]
    },
    {
      "displayName": "Output File",
      "description": "File to write output to",
      "parameterType": "Option",
      "dataType": "String",
      "key": "-output",
      "aliases": [
        "-o"
      ]
    },
    {
      "displayName": "Verbose Output",
      "description": "Show verbose output",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-v"
    },
    {
      "displayName": "Resolvers",
      "description": "Comma separated list of resolvers to use",
      "parameterType": "Option",
      "dataType": "String",
      "arraySeparator": ",",
      "isRepeatable": true,
      "key": "-r"
    },
    {
      "displayName": "Json",
      "description": "Write output in JSONL(ines) format",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-json",
      "aliases": [
        "-oJ"
      ]
    },
    {
      "displayName": "Configuration File",
      "description": "Subfinder config file",
      "parameterType": "Option",
      "dataType": "String",
      "key": "-config"
    },
    {
      "displayName": "Rate Limit",
      "description": "Maximum number of http requests to send per second (global)",
      "parameterType": "Option",
      "dataType": "Number",
      "key": "-rate-limit",
      "aliases": [
        "-rl"
      ]
    },
    {
      "displayName": "Filter",
      "description": "Subdomain or list of subdomain to filter (file or comma separated)",
      "parameterType": "Option",
      "dataType": "String",
      "arraySeparator": ",",
      "isRepeatable": true,
      "key": "-filter",
      "aliases": [
        "-f"
      ]
    },
    {
      "displayName": "Silent",
      "description": "Show only subdomains in output",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-silent"
    },
    {
      "displayName": "All Sources",
      "description": "Use all sources for enumeration (slow)",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-all"
    },
    {
      "displayName": "List Sources",
      "description": "List all available sources",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-list-sources",
      "aliases": [
        "-ls"
      ]
    },
    {
      "displayName": "Exclude Sources",
      "description": "Sources to exclude from enumeration (-es alienvault,zoomeyeapi)",
      "parameterType": "Option",
      "dataType": "String",
      "arraySeparator": ",",
      "isRepeatable": true,
      "key": "-exclude-sources",
      "aliases": [
        "-es"
      ]
    },
    {
      "displayName": "Max Time",
      "description": "Minutes to wait for enumeration results (default 10)",
      "parameterType": "Option",
      "dataType": "Number",
      "key": "-max-time"
    },
    {
      "displayName": "Threads",
      "description": "Number of concurrent goroutines for resolving (-active only) (default 10)",
      "parameterType": "Option",
      "dataType": "Number",
      "key": "-t"
    },
    {
      "displayName": "Provider Configuration File",
      "description": "Provider config file",
      "parameterType": "Option",
      "dataType": "String",
      "key": "-provider-config",
      "aliases": [
        "-pc"
      ]
    },
    {
      "displayName": "Match Regex",
      "description": "Regex or list of regex to match on output subdomain (cli, file)",
      "parameterType": "Option",
      "dataType": "String",
      "arraySeparator": ",",
      "isRepeatable": true,
      "key": "-match-regex"
    },
    {
      "displayName": "Filter Regex",
      "description": "Regex or list of regex to filter on output subdomain (cli, file)",
      "parameterType": "Option",
      "dataType": "String",
      "arraySeparator": ",",
      "isRepeatable": true,
      "key": "-filter-regex"
    },
    {
      "displayName": "Max Results",
      "description": "Limit the number of results per source (0 = unlimited; honored by paginating sources)",
      "parameterType": "Option",
      "dataType": "Number",
      "key": "-max-results",
      "aliases": [
        "-mr"
      ]
    },
    {
      "displayName": "Response Size Read",
      "description": "Max response body size to read in bytes from passive sources (0 = unlimited)",
      "parameterType": "Option",
      "dataType": "Number",
      "key": "-response-size-read",
      "aliases": [
        "-rsr"
      ]
    }
  ],
  "installation": {
    "sources": [
      {
        "key": "go-install",
        "method": "package_manager",
        "manager": "go",
        "command": "go install -v github.com/projectdiscovery/subfinder/v2/cmd/subfinder@latest",
        "url": "https://docs.projectdiscovery.io/opensource/subfinder/install"
      },
      {
        "key": "brew",
        "method": "package_manager",
        "manager": "brew",
        "command": "brew install subfinder",
        "url": "https://docs.projectdiscovery.io/opensource/subfinder/install",
        "os": [
          "linux",
          "macos"
        ]
      },
      {
        "key": "docker",
        "method": "docker",
        "command": "docker pull projectdiscovery/subfinder:latest",
        "url": "https://docs.projectdiscovery.io/opensource/subfinder/install"
      },
      {
        "key": "release-binary",
        "method": "binary",
        "command": "https://github.com/projectdiscovery/subfinder/releases",
        "url": "https://docs.projectdiscovery.io/opensource/subfinder/install",
        "note": "Download the latest binary for your OS and unzip it."
      }
    ]
  }
}
