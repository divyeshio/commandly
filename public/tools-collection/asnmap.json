{
  "$schema": "https://commandly.divyeshio.in/specification/tool.json",
  "binaryName": "asnmap",
  "displayName": "ASNMap",
  "info": {
    "description": "Go CLI and Library for quickly mapping organization network ranges using ASN information.",
    "version": "1.1.1",
    "url": "https://github.com/projectdiscovery/asnmap"
  },
  "commands": [],
  "parameters": [
    {
      "displayName": "ASN",
      "description": "Target ASN to lookup, example: -a AS5650",
      "parameterType": "Option",
      "dataType": "String",
      "isRepeatable": true,
      "sortOrder": 1,
      "arraySeparator": ",",
      "key": "-asn",
      "aliases": [
        "-a"
      ]
    },
    {
      "displayName": "IP",
      "description": "Target IP to lookup, example: -i 100.19.12.21, -i 2a10:ad40::",
      "parameterType": "Option",
      "dataType": "String",
      "isRepeatable": true,
      "sortOrder": 2,
      "arraySeparator": ",",
      "key": "-ip",
      "aliases": [
        "-i"
      ]
    },
    {
      "displayName": "Domain",
      "description": "Target domain to lookup, example: -d google.com, -d facebook.com",
      "parameterType": "Option",
      "dataType": "String",
      "isRepeatable": true,
      "sortOrder": 3,
      "arraySeparator": ",",
      "key": "-domain",
      "aliases": [
        "-d"
      ]
    },
    {
      "displayName": "Org",
      "description": "Target organization to lookup, example: -org GOOGLE",
      "parameterType": "Option",
      "dataType": "String",
      "isRepeatable": true,
      "sortOrder": 4,
      "arraySeparator": ",",
      "key": "-org"
    },
    {
      "displayName": "File",
      "description": "Targets to lookup from file",
      "parameterType": "Option",
      "dataType": "String",
      "isRepeatable": true,
      "sortOrder": 5,
      "arraySeparator": ",",
      "key": "-file",
      "aliases": [
        "-f"
      ]
    },
    {
      "displayName": "Config",
      "description": "Path to the asnmap configuration file",
      "parameterType": "Option",
      "dataType": "String",
      "sortOrder": 6,
      "key": "-config"
    },
    {
      "displayName": "Resolvers",
      "description": "List of resolvers to use",
      "parameterType": "Option",
      "dataType": "String",
      "isRepeatable": true,
      "sortOrder": 7,
      "arraySeparator": ",",
      "key": "-resolvers",
      "aliases": [
        "-r"
      ]
    },
    {
      "displayName": "Update",
      "description": "Update asnmap to latest version",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 8,
      "key": "-update",
      "aliases": [
        "-up"
      ]
    },
    {
      "displayName": "Disable Update Check",
      "description": "Disable automatic asnmap update check",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 9,
      "key": "-disable-update-check",
      "aliases": [
        "-duc"
      ]
    },
    {
      "displayName": "Output File",
      "description": "File to write output to",
      "parameterType": "Option",
      "dataType": "String",
      "sortOrder": 10,
      "key": "-output",
      "aliases": [
        "-o"
      ]
    },
    {
      "displayName": "JSON Output",
      "description": "Display JSON format output",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 11,
      "key": "-json",
      "aliases": [
        "-j"
      ]
    },
    {
      "displayName": "CSV Output",
      "description": "Display CSV format output",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 12,
      "key": "-csv",
      "aliases": [
        "-c"
      ]
    },
    {
      "displayName": "IPv6 Output",
      "description": "Display IPv6 CIDR ranges in CLI output",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 13,
      "key": "-v6"
    },
    {
      "displayName": "Verbose Output",
      "description": "Display verbose output",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 14,
      "key": "-verbose",
      "aliases": [
        "-v"
      ]
    },
    {
      "displayName": "Silent",
      "description": "Display silent output",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 15,
      "key": "-silent"
    },
    {
      "displayName": "Version",
      "description": "Show version of the project",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 16,
      "key": "-version"
    }
  ],
  "installation": {
    "sources": [
      {
        "key": "go-install",
        "method": "package_manager",
        "manager": "go",
        "command": "go install github.com/projectdiscovery/asnmap/cmd/asnmap@latest",
        "url": "https://github.com/projectdiscovery/asnmap#installation",
        "note": "Requires Go 1.21."
      },
      {
        "key": "release-binary",
        "method": "binary",
        "command": "https://github.com/projectdiscovery/asnmap/releases",
        "url": "https://github.com/projectdiscovery/asnmap#installation",
        "note": "Download the pre-compiled binary for your OS."
      }
    ]
  }
}
