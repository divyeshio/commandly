{
  "$schema": "https://commandly.divyeshio.in/specification/tool.json",
  "binaryName": "cdncheck",
  "displayName": "CDNCheck",
  "info": {
    "description": "cdncheck is a tool for identifying the technology associated with dns / ip network addresses.",
    "version": "1.3.2",
    "url": "https://github.com/projectdiscovery/cdncheck"
  },
  "commands": [],
  "parameters": [
    {
      "displayName": "Input",
      "description": "List of IP / DNS to process",
      "parameterType": "Option",
      "dataType": "String",
      "isRepeatable": true,
      "sortOrder": 1,
      "key": "-input",
      "aliases": [
        "-i"
      ]
    },
    {
      "displayName": "CDN",
      "description": "Display only CDN in CLI output",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 2,
      "key": "-cdn"
    },
    {
      "displayName": "Cloud",
      "description": "Display only cloud in CLI output",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 3,
      "key": "-cloud"
    },
    {
      "displayName": "WAF",
      "description": "Display only WAF in CLI output",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 4,
      "key": "-waf"
    },
    {
      "displayName": "Match CDN",
      "description": "Match host with specified CDN provider (cloudfront, fastly, google, leaseweb)",
      "parameterType": "Option",
      "dataType": "Enum",
      "isRepeatable": true,
      "sortOrder": 5,
      "key": "-match-cdn",
      "enum": {
        "allowMultiple": true,
        "values": [
          {
            "value": "cloudfront",
            "displayName": "Cloudfront"
          },
          {
            "value": "fastly",
            "displayName": "Fastly"
          },
          {
            "value": "google",
            "displayName": "Google"
          },
          {
            "value": "leaseweb",
            "displayName": "Leaseweb"
          }
        ]
      },
      "aliases": [
        "-mcdn"
      ]
    },
    {
      "displayName": "Match Cloud",
      "description": "Match host with specified cloud provider (aws, google, oracle)",
      "parameterType": "Option",
      "dataType": "Enum",
      "isRepeatable": true,
      "sortOrder": 6,
      "key": "-match-cloud",
      "enum": {
        "values": [
          {
            "value": "aws",
            "displayName": "AWS"
          },
          {
            "value": "google",
            "displayName": "Google"
          },
          {
            "value": "oracle",
            "displayName": "Oracle"
          }
        ]
      },
      "aliases": [
        "-mcloud"
      ]
    },
    {
      "displayName": "Match WAF",
      "description": "Match host with specified WAF provider (cloudflare, incapsula, sucuri, akamai)",
      "parameterType": "Option",
      "dataType": "Enum",
      "isRepeatable": true,
      "sortOrder": 7,
      "key": "-match-waf",
      "enum": {
        "values": [
          {
            "value": "cloudflare",
            "displayName": "Cloudflare"
          },
          {
            "value": "incapsula",
            "displayName": "Incapsula"
          },
          {
            "value": "sucuri",
            "displayName": "Sucuri"
          },
          {
            "value": "akamai",
            "displayName": "Akamai"
          }
        ]
      },
      "aliases": [
        "-mwaf"
      ]
    },
    {
      "displayName": "Filter CDN",
      "description": "Filter host with specified CDN provider (cloudfront, fastly, google, leaseweb)",
      "parameterType": "Option",
      "dataType": "Enum",
      "isRepeatable": true,
      "sortOrder": 8,
      "key": "-filter-cdn",
      "enum": {
        "allowMultiple": true,
        "values": [
          {
            "value": "cloudfront",
            "displayName": "Cloudfront"
          },
          {
            "value": "fastly",
            "displayName": "Fastly"
          },
          {
            "value": "google",
            "displayName": "Google"
          },
          {
            "value": "leaseweb",
            "displayName": "Leaseweb"
          }
        ]
      },
      "aliases": [
        "-fcdn"
      ]
    },
    {
      "displayName": "Filter Cloud",
      "description": "Filter host with specified cloud provider (aws, google, oracle)",
      "parameterType": "Option",
      "dataType": "Enum",
      "isRepeatable": true,
      "sortOrder": 9,
      "key": "-filter-cloud",
      "enum": {
        "allowMultiple": true,
        "values": [
          {
            "value": "aws",
            "displayName": "AWS"
          },
          {
            "value": "google",
            "displayName": "Google"
          },
          {
            "value": "oracle",
            "displayName": "Oracle"
          }
        ]
      },
      "aliases": [
        "-fcloud"
      ]
    },
    {
      "displayName": "Filter WAF",
      "description": "Filter host with specified WAF provider (cloudflare, incapsula, sucuri, akamai)",
      "parameterType": "Option",
      "dataType": "Enum",
      "isRepeatable": true,
      "sortOrder": 10,
      "key": "-filter-waf",
      "enum": {
        "values": [
          {
            "value": "cloudflare",
            "displayName": "Cloudflare"
          },
          {
            "value": "incapsula",
            "displayName": "Incapsula"
          },
          {
            "value": "sucuri",
            "displayName": "Sucuri"
          },
          {
            "value": "akamai",
            "displayName": "Akamai"
          }
        ]
      },
      "aliases": [
        "-fwaf"
      ]
    },
    {
      "displayName": "Response Technology",
      "description": "Display technology name in CLI output",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 11,
      "key": "-resp"
    },
    {
      "displayName": "Output",
      "description": "Write output in plain format to file",
      "parameterType": "Option",
      "dataType": "String",
      "sortOrder": 12,
      "key": "-output",
      "aliases": [
        "-o"
      ]
    },
    {
      "displayName": "Verbose",
      "description": "Display verbose output",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 13,
      "key": "-verbose",
      "aliases": [
        "-v"
      ]
    },
    {
      "displayName": "JSONL Output",
      "description": "Write output in JSON Lines format",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 14,
      "key": "-jsonl",
      "aliases": [
        "-j"
      ]
    },
    {
      "displayName": "No Color",
      "description": "Disable colors in CLI output",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 15,
      "key": "-no-color",
      "aliases": [
        "-nc"
      ]
    },
    {
      "displayName": "Version",
      "description": "Display version of the project",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 16,
      "key": "-version"
    },
    {
      "displayName": "Silent",
      "description": "Only display results in output",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 17,
      "key": "-silent"
    },
    {
      "displayName": "Resolver",
      "description": "List of resolvers to use (file or comma separated)",
      "parameterType": "Option",
      "dataType": "String",
      "isRepeatable": true,
      "sortOrder": 18,
      "key": "-resolver",
      "aliases": [
        "-r"
      ]
    },
    {
      "displayName": "Exclude",
      "description": "Exclude detected IP from output",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 19,
      "key": "-exclude",
      "aliases": [
        "-e"
      ]
    },
    {
      "displayName": "Retry",
      "description": "Maximum number of retries for DNS resolution (must be at least 1)",
      "parameterType": "Option",
      "dataType": "Number",
      "sortOrder": 20,
      "key": "-retry"
    },
    {
      "displayName": "Update",
      "description": "Update cdncheck to latest version",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 21,
      "key": "-update",
      "aliases": [
        "-up"
      ]
    },
    {
      "displayName": "Disable Update Check",
      "description": "Disable automatic cdncheck update check",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 22,
      "key": "-disable-update-check",
      "aliases": [
        "-duc"
      ]
    }
  ],
  "exclusionGroups": [
    {
      "displayName": "Detection",
      "exclusionType": "mutual_exclusive",
      "key": "detection",
      "parameterKeys": [
        "-cdn",
        "-cloud",
        "-waf"
      ]
    },
    {
      "displayName": "Filter",
      "exclusionType": "mutual_exclusive",
      "key": "filter",
      "parameterKeys": [
        "-filter-cdn",
        "-filter-cloud",
        "-filter-waf"
      ]
    }
  ],
  "installation": {
    "sources": [
      {
        "key": "go-install",
        "method": "package_manager",
        "manager": "go",
        "command": "go install -v github.com/projectdiscovery/cdncheck/cmd/cdncheck@latest",
        "url": "https://github.com/projectdiscovery/cdncheck#installation",
        "note": "Requires Go 1.19."
      }
    ]
  }
}
