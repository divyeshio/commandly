{
  "$schema": "https://commandly.divyeshio.in/specification/tool.json",
  "binaryName": "notify",
  "displayName": "Notify",
  "commands": [],
  "parameters": [
    {
      "key": "-bulk",
      "displayName": "Bulk",
      "description": "Enable bulk processing.",
      "parameterType": "Flag",
      "dataType": "Boolean"
    },
    {
      "key": "-char-limit",
      "displayName": "Character Limit",
      "description": "Maximum character limit per message.",
      "parameterType": "Option",
      "dataType": "Number",
      "validations": [
        {
          "key": "min_value-1",
          "validationType": "min_value",
          "validationValue": "1",
          "errorMessage": "Character limit must be at least 1.",
          "parameterKey": "char-limit"
        }
      ],
      "aliases": [
        "-cl"
      ]
    },
    {
      "key": "-config",
      "displayName": "Config",
      "description": "Notify configuration file path.",
      "parameterType": "Option",
      "dataType": "String"
    },
    {
      "key": "-data",
      "displayName": "Data",
      "description": "Input file to send to Notify.",
      "parameterType": "Option",
      "dataType": "String",
      "aliases": [
        "-i"
      ]
    },
    {
      "key": "-delay",
      "displayName": "Delay",
      "description": "Delay in seconds between notifications.",
      "parameterType": "Option",
      "dataType": "Number",
      "validations": [
        {
          "key": "min_value-0",
          "validationType": "min_value",
          "validationValue": "0",
          "errorMessage": "Delay must be at least 0.",
          "parameterKey": "delay"
        }
      ],
      "aliases": [
        "-d"
      ]
    },
    {
      "key": "-id",
      "displayName": "ID",
      "description": "Comma-separated notification IDs.",
      "parameterType": "Option",
      "dataType": "String"
    },
    {
      "key": "-msg-format",
      "displayName": "Message Format",
      "description": "Custom message format.",
      "parameterType": "Option",
      "dataType": "String",
      "aliases": [
        "-mf"
      ]
    },
    {
      "key": "-no-color",
      "displayName": "No Color",
      "description": "Disable colored output.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "aliases": [
        "-nc"
      ]
    },
    {
      "key": "-provider-config",
      "displayName": "Provider Config",
      "description": "Provider config file path.",
      "parameterType": "Option",
      "dataType": "String",
      "aliases": [
        "-pc"
      ]
    },
    {
      "key": "-provider",
      "displayName": "Provider",
      "description": "Comma-separated providers to send notifications to.",
      "parameterType": "Option",
      "dataType": "Enum",
      "enum": {
        "values": [
          {
            "value": "slack",
            "displayName": "Slack",
            "sortOrder": 0
          },
          {
            "value": "discord",
            "displayName": "Discord",
            "sortOrder": 1
          },
          {
            "value": "telegram",
            "displayName": "Telegram",
            "sortOrder": 2
          },
          {
            "value": "pushover",
            "displayName": "Pushover",
            "sortOrder": 3
          },
          {
            "value": "smtp",
            "displayName": "SMTP",
            "sortOrder": 4
          },
          {
            "value": "googlechat",
            "displayName": "Google Chat",
            "sortOrder": 5
          },
          {
            "value": "teams",
            "displayName": "Teams",
            "sortOrder": 6
          },
          {
            "value": "gotify",
            "displayName": "Gotify",
            "sortOrder": 7
          },
          {
            "value": "custom",
            "displayName": "Custom",
            "sortOrder": 8
          }
        ],
        "allowMultiple": true,
        "separator": ","
      },
      "aliases": [
        "-p"
      ]
    },
    {
      "key": "-proxy",
      "displayName": "Proxy",
      "description": "HTTP or SOCKSv5 proxy to use.",
      "parameterType": "Option",
      "dataType": "String"
    },
    {
      "key": "-rate-limit",
      "displayName": "Rate Limit",
      "description": "Maximum HTTP requests per second.",
      "parameterType": "Option",
      "dataType": "Number",
      "validations": [
        {
          "key": "min_value-1",
          "validationType": "min_value",
          "validationValue": "1",
          "errorMessage": "Rate limit must be at least 1.",
          "parameterKey": "rate-limit"
        }
      ],
      "aliases": [
        "-rl"
      ]
    },
    {
      "key": "-silent",
      "displayName": "Silent",
      "description": "Enable silent mode.",
      "parameterType": "Flag",
      "dataType": "Boolean"
    },
    {
      "key": "-verbose",
      "displayName": "Verbose",
      "description": "Enable verbose mode.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "aliases": [
        "-v"
      ]
    },
    {
      "key": "-version",
      "displayName": "Version",
      "description": "Display the version.",
      "parameterType": "Flag",
      "dataType": "Boolean"
    },
    {
      "key": "-update",
      "displayName": "Update",
      "description": "Update to the latest version.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "aliases": [
        "-up"
      ]
    },
    {
      "key": "-disable-update-check",
      "displayName": "Disable Update Check",
      "description": "Disable automatic update checks.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "aliases": [
        "-duc"
      ]
    }
  ],
  "info": {
    "url": "https://github.com/projectdiscovery/notify",
    "description": "Stream output from files or pipes to notification providers.",
    "version": "1.0.7"
  },
  "installation": {
    "sources": [
      {
        "key": "go-install",
        "method": "package_manager",
        "manager": "go",
        "command": "go install -v github.com/projectdiscovery/notify/cmd/notify@latest",
        "url": "https://docs.projectdiscovery.io/opensource/notify/install"
      }
    ]
  }
}
