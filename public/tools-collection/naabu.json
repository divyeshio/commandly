      "parameterType": "Option",
      "dataType": "String",
      "sortOrder": 1,
      "key": "-host"
    },
    {
      "displayName": "List",
      "description": "List of hosts to scan ports (file).",
      "parameterType": "Option",
      "dataType": "String",
      "sortOrder": 2,
      "key": "-list",
      "aliases": [
        "-l"
      ]
    },
    {
