        "values": [
          {
            "value": "full",
            "displayName": "Full",
            "description": "Scan full set of top ports.",
            "sortOrder": 1,
            "isDefault": false
          },
          {
            "value": "100",
            "displayName": "100",
            "description": "Scan top 100 ports.",
            "sortOrder": 2,
            "isDefault": true
          },
          {
            "value": "1000",
            "displayName": "1000",
            "description": "Scan top 1000 ports.",
            "sortOrder": 3,
            "isDefault": false
          }
