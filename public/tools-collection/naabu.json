{
  "$schema": "https://commandly.divyeshio.in/specification/tool.json",
  "binaryName": "naabu",
  "displayName": "Naabu",
  "info": {
    "description": "Fast port scanner for discovering open ports on hosts.",
    "version": "2.6.1",
    "url": "https://github.com/projectdiscovery/naabu"
  },
  "commands": [],
