  "installation": {
    "sources": [
      {
        "key": "go-install",
        "method": "package_manager",
        "manager": "go",
        "command": "go install -v github.com/projectdiscovery/naabu/v2/cmd/naabu@latest",
        "url": "https://docs.projectdiscovery.io/opensource/naabu/install",
        "note": "Requires libpcap: sudo apt install -y libpcap-dev on Linux, brew install libpcap on macOS."
      },
      {
        "key": "release-binary",
        "method": "binary",
        "command": "https://github.com/projectdiscovery/naabu/releases",
        "url": "https://docs.projectdiscovery.io/opensource/naabu/install",
        "note": "Download the latest binary for your OS and unzip it."
      }
    ]
  }
}
