{
  "$schema": "https://commandly.divyeshio.in/specification/tool.json",
  "binaryName": "ffuf",
  "displayName": "ffuf",
  "info": {
    "description": "A fast web fuzzer written in Go.",
    "version": "2.3.0",
    "url": "https://github.com/ffuf/ffuf"
  },
  "commands": [],
  "parameters": [
    {
      "key": "-u",
      "displayName": "URL",
      "parameterType": "Option",
      "dataType": "String",
      "description": "Target URL.",
      "isRequired": true,
      "group": "HTTP",
      "sortOrder": 1
    },
    {
      "key": "-X",
      "displayName": "Method",
      "parameterType": "Option",
      "dataType": "String",
      "description": "HTTP method to use.",
      "group": "HTTP",
      "sortOrder": 2
    },
    {
      "key": "-d",
      "displayName": "POST Data",
      "parameterType": "Option",
      "dataType": "String",
      "description": "POST data.",
      "group": "HTTP",
      "sortOrder": 3
    },
    {
      "key": "-b",
      "displayName": "Cookie",
      "parameterType": "Option",
      "dataType": "String",
      "description": "Cookie data \"NAME1=VALUE1; NAME2=VALUE2\" for copy as curl functionality.",
      "group": "HTTP",
      "sortOrder": 4
    },
    {
      "key": "-H",
      "displayName": "Header",
      "parameterType": "Option",
      "dataType": "String",
      "description": "Header \"Name: Value\", separated by colon. Multiple -H flags are accepted.",
      "isRepeatable": true,
      "group": "HTTP",
      "sortOrder": 5
    },
    {
      "key": "-cc",
      "displayName": "Client Certificate",
      "parameterType": "Option",
      "dataType": "String",
      "description": "Client cert for authentication. Client key needs to be defined as well.",
      "group": "HTTP",
      "sortOrder": 6
    },
    {
      "key": "-ck",
      "displayName": "Client Key",
      "parameterType": "Option",
      "dataType": "String",
      "description": "Client key for authentication. Client certificate needs to be defined as well.",
      "group": "HTTP",
      "sortOrder": 7
    },
    {
      "key": "-x",
      "displayName": "Proxy",
      "parameterType": "Option",
      "dataType": "String",
      "description": "Proxy URL (SOCKS5 or HTTP). For example: http://127.0.0.1:8080 or socks5://127.0.0.1:8080.",
      "group": "HTTP",
      "sortOrder": 8
    },
    {
      "key": "-replay-proxy",
      "displayName": "Replay Proxy",
      "parameterType": "Option",
      "dataType": "String",
      "description": "Replay matched requests using this proxy.",
      "group": "HTTP",
      "sortOrder": 9
    },
    {
      "key": "-r",
      "displayName": "Follow Redirects",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "description": "Follow redirects.",
      "group": "HTTP",
      "sortOrder": 10
    },
    {
      "key": "-timeout",
      "displayName": "Timeout",
      "parameterType": "Option",
      "dataType": "Number",
      "description": "HTTP request timeout in seconds.",
      "group": "HTTP",
      "sortOrder": 11
    },
    {
      "key": "-http2",
      "displayName": "HTTP2",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "description": "Use HTTP2 protocol.",
      "group": "HTTP",
      "sortOrder": 12
    },
    {
      "key": "-sni",
      "displayName": "SNI",
      "parameterType": "Option",
      "dataType": "String",
      "description": "Target TLS SNI, does not support FUZZ keyword.",
      "group": "HTTP",
      "sortOrder": 13
    },
    {
      "key": "-raw",
      "displayName": "Raw",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "description": "Do not encode URI.",
      "group": "HTTP",
      "sortOrder": 14
    },
    {
      "key": "-ignore-body",
      "displayName": "Ignore Body",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "description": "Do not fetch the response content.",
      "group": "HTTP",
      "sortOrder": 15
    },
    {
      "key": "-recursion",
      "displayName": "Recursion",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "description": "Scan recursively. Only FUZZ keyword is supported, and URL must end in it.",
      "group": "HTTP",
      "sortOrder": 16
    },
    {
      "key": "-recursion-depth",
      "displayName": "Recursion Depth",
      "parameterType": "Option",
      "dataType": "Number",
      "description": "Maximum recursion depth.",
      "group": "HTTP",
      "sortOrder": 17
    },
    {
      "key": "-recursion-strategy",
      "displayName": "Recursion Strategy",
      "parameterType": "Option",
      "dataType": "Enum",
      "description": "Recursion strategy.",
      "group": "HTTP",
      "sortOrder": 18,
      "enum": {
        "values": [
          {
            "value": "default",
            "displayName": "Default",
            "description": "Redirect-based recursion.",
            "isDefault": true,
            "sortOrder": 1
          },
          {
            "value": "greedy",
            "displayName": "Greedy",
            "description": "Recurse on all matches.",
            "sortOrder": 2
          }
        ]
      }
    },
    {
      "key": "-t",
      "displayName": "Threads",
      "parameterType": "Option",
      "dataType": "Number",
      "description": "Number of concurrent threads.",
      "group": "General",
      "sortOrder": 19
    },
    {
      "key": "-rate",
      "displayName": "Rate",
      "parameterType": "Option",
      "dataType": "Number",
      "description": "Rate of requests per second.",
      "group": "General",
      "sortOrder": 20
    },
    {
      "key": "-p",
      "displayName": "Delay",
      "parameterType": "Option",
      "dataType": "String",
      "description": "Seconds of delay between requests, or a range of random delay. For example \"0.1\" or \"0.1-2.0\".",
      "group": "General",
      "sortOrder": 21
    },
    {
      "key": "-maxtime",
      "displayName": "Max Time",
      "parameterType": "Option",
      "dataType": "Number",
      "description": "Maximum running time in seconds for entire process.",
      "group": "General",
      "sortOrder": 22
    },
    {
      "key": "-maxtime-job",
      "displayName": "Max Time Per Job",
      "parameterType": "Option",
      "dataType": "Number",
      "description": "Maximum running time in seconds per job.",
      "group": "General",
      "sortOrder": 23
    },
    {
      "key": "-ac",
      "displayName": "Auto-Calibrate",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "description": "Automatically calibrate filtering options.",
      "group": "General",
      "sortOrder": 24
    },
    {
      "key": "-acc",
      "displayName": "Auto-Calibrate String",
      "parameterType": "Option",
      "dataType": "String",
      "description": "Custom auto-calibration string. Can be used multiple times. Implies -ac.",
      "isRepeatable": true,
      "group": "General",
      "sortOrder": 25
    },
    {
      "key": "-ach",
      "displayName": "Auto-Calibrate Per Host",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "description": "Per host autocalibration.",
      "group": "General",
      "sortOrder": 26
    },
    {
      "key": "-ack",
      "displayName": "Auto-Calibrate Keyword",
      "parameterType": "Option",
      "dataType": "String",
      "description": "Autocalibration keyword.",
      "group": "General",
      "sortOrder": 27
    },
    {
      "key": "-acs",
      "displayName": "Auto-Calibrate Strategy",
      "parameterType": "Option",
      "dataType": "String",
      "description": "Custom auto-calibration strategies. Can be used multiple times. Implies -ac.",
      "isRepeatable": true,
      "group": "General",
      "sortOrder": 28
    },
    {
      "key": "-sa",
      "displayName": "Stop on All Errors",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "description": "Stop on all error cases. Implies -sf and -se.",
      "group": "General",
      "sortOrder": 29
    },
    {
      "key": "-se",
      "displayName": "Stop on Spurious Errors",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "description": "Stop on spurious errors.",
      "group": "General",
      "sortOrder": 30
    },
    {
      "key": "-sf",
      "displayName": "Stop on Forbidden",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "description": "Stop when > 95% of responses return 403 Forbidden.",
      "group": "General",
      "sortOrder": 31
    },
    {
      "key": "-scrapers",
      "displayName": "Scrapers",
      "parameterType": "Option",
      "dataType": "String",
      "description": "Active scraper groups.",
      "group": "General",
      "sortOrder": 32
    },
    {
      "key": "-scraperfile",
      "displayName": "Scraper File",
      "parameterType": "Option",
      "dataType": "String",
      "description": "Custom scraper file path.",
      "group": "General",
      "sortOrder": 33
    },
    {
      "key": "-c",
      "displayName": "Colorize",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "description": "Colorize output.",
      "group": "General",
      "sortOrder": 34
    },
    {
      "key": "-s",
      "displayName": "Silent",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "description": "Do not print additional information (silent mode).",
      "group": "General",
      "sortOrder": 35
    },
    {
      "key": "-v",
      "displayName": "Verbose",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "description": "Verbose output, printing full URL and redirect location with the results.",
      "group": "General",
      "sortOrder": 36
    },
    {
      "key": "-json",
      "displayName": "JSON Output",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "description": "JSON output, printing newline-delimited JSON records.",
      "group": "General",
      "sortOrder": 37
    },
    {
      "key": "-config",
      "displayName": "Config File",
      "parameterType": "Option",
      "dataType": "String",
      "description": "Load configuration from a file.",
      "group": "General",
      "sortOrder": 38
    },
    {
      "key": "-search",
      "displayName": "Search",
      "parameterType": "Option",
      "dataType": "String",
      "description": "Search for a FFUFHASH payload from ffuf history.",
      "group": "General",
      "sortOrder": 39
    },
    {
      "key": "-noninteractive",
      "displayName": "Non-Interactive",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "description": "Disable the interactive console functionality.",
      "group": "General",
      "sortOrder": 40
    },
    {
      "key": "-V",
      "displayName": "Version",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "description": "Show version information.",
      "group": "General",
      "sortOrder": 41
    },
    {
      "key": "-mc",
      "displayName": "Match Codes",
      "parameterType": "Option",
      "dataType": "String",
      "description": "Match HTTP status codes, or \"all\" for everything.",
      "group": "Matcher",
      "sortOrder": 42
    },
    {
      "key": "-ms",
      "displayName": "Match Size",
      "parameterType": "Option",
      "dataType": "String",
      "description": "Match HTTP response size.",
      "group": "Matcher",
      "sortOrder": 43
    },
    {
      "key": "-ml",
      "displayName": "Match Lines",
      "parameterType": "Option",
      "dataType": "String",
      "description": "Match amount of lines in response.",
      "group": "Matcher",
      "sortOrder": 44
    },
    {
      "key": "-mw",
      "displayName": "Match Words",
      "parameterType": "Option",
      "dataType": "String",
      "description": "Match amount of words in response.",
      "group": "Matcher",
      "sortOrder": 45
    },
    {
      "key": "-mt",
      "displayName": "Match Time",
      "parameterType": "Option",
      "dataType": "String",
      "description": "Match how many milliseconds to the first response byte, either greater or less than. E.g. >100 or <100.",
      "group": "Matcher",
      "sortOrder": 46
    },
    {
      "key": "-mr",
      "displayName": "Match Regexp",
      "parameterType": "Option",
      "dataType": "String",
      "description": "Match regexp.",
      "group": "Matcher",
      "sortOrder": 47
    },
    {
      "key": "-mmode",
      "displayName": "Match Mode",
      "parameterType": "Option",
      "dataType": "Enum",
      "description": "Matcher set operator.",
      "group": "Matcher",
      "sortOrder": 48,
      "enum": {
        "values": [
          {
            "value": "or",
            "displayName": "Or",
            "isDefault": true,
            "sortOrder": 1
          },
          {
            "value": "and",
            "displayName": "And",
            "sortOrder": 2
          }
        ]
      }
    },
    {
      "key": "-fc",
      "displayName": "Filter Codes",
      "parameterType": "Option",
      "dataType": "String",
      "description": "Filter HTTP status codes from response. Comma separated list of codes and ranges.",
      "group": "Filter",
      "sortOrder": 49
    },
    {
      "key": "-fs",
      "displayName": "Filter Size",
      "parameterType": "Option",
      "dataType": "String",
      "description": "Filter HTTP response size. Comma separated list of sizes and ranges.",
      "group": "Filter",
      "sortOrder": 50
    },
    {
      "key": "-fl",
      "displayName": "Filter Lines",
      "parameterType": "Option",
      "dataType": "String",
      "description": "Filter by amount of lines in response. Comma separated list of line counts and ranges.",
      "group": "Filter",
      "sortOrder": 51
    },
    {
      "key": "-fw",
      "displayName": "Filter Words",
      "parameterType": "Option",
      "dataType": "String",
      "description": "Filter by amount of words in response. Comma separated list of word counts and ranges.",
      "group": "Filter",
      "sortOrder": 52
    },
    {
      "key": "-ft",
      "displayName": "Filter Time",
      "parameterType": "Option",
      "dataType": "String",
      "description": "Filter by number of milliseconds to the first response byte, either greater or less than. E.g. >100 or <100.",
      "group": "Filter",
      "sortOrder": 53
    },
    {
      "key": "-fr",
      "displayName": "Filter Regexp",
      "parameterType": "Option",
      "dataType": "String",
      "description": "Filter regexp.",
      "group": "Filter",
      "sortOrder": 54
    },
    {
      "key": "-fmode",
      "displayName": "Filter Mode",
      "parameterType": "Option",
      "dataType": "Enum",
      "description": "Filter set operator.",
      "group": "Filter",
      "sortOrder": 55,
      "enum": {
        "values": [
          {
            "value": "or",
            "displayName": "Or",
            "isDefault": true,
            "sortOrder": 1
          },
          {
            "value": "and",
            "displayName": "And",
            "sortOrder": 2
          }
        ]
      }
    },
    {
      "key": "-w",
      "displayName": "Wordlist",
      "parameterType": "Option",
      "dataType": "String",
      "description": "Wordlist file path and (optional) keyword separated by colon. E.g. '/path/to/wordlist:KEYWORD'.",
      "isRepeatable": true,
      "group": "Input",
      "sortOrder": 56
    },
    {
      "key": "-e",
      "displayName": "Extensions",
      "parameterType": "Option",
      "dataType": "String",
      "description": "Comma separated list of extensions. Extends FUZZ keyword.",
      "group": "Input",
      "sortOrder": 57
    },
    {
      "key": "-D",
      "displayName": "DirSearch Compatibility",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "description": "DirSearch wordlist compatibility mode. Used in conjunction with -e flag.",
      "group": "Input",
      "sortOrder": 58
    },
    {
      "key": "-mode",
      "displayName": "Mode",
      "parameterType": "Option",
      "dataType": "Enum",
      "description": "Multi-wordlist operation mode.",
      "group": "Input",
      "sortOrder": 59,
      "enum": {
        "values": [
          {
            "value": "clusterbomb",
            "displayName": "Cluster Bomb",
            "isDefault": true,
            "sortOrder": 1
          },
          {
            "value": "pitchfork",
            "displayName": "Pitchfork",
            "sortOrder": 2
          },
          {
            "value": "sniper",
            "displayName": "Sniper",
            "sortOrder": 3
          }
        ]
      }
    },
    {
      "key": "-enc",
      "displayName": "Encoders",
      "parameterType": "Option",
      "dataType": "String",
      "description": "Encoders for keywords, e.g. 'FUZZ:urlencode b64encode'.",
      "group": "Input",
      "sortOrder": 60
    },
    {
      "key": "-ic",
      "displayName": "Ignore Comments",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "description": "Ignore wordlist comments.",
      "group": "Input",
      "sortOrder": 61
    },
    {
      "key": "-request",
      "displayName": "Request File",
      "parameterType": "Option",
      "dataType": "String",
      "description": "File containing the raw HTTP request.",
      "group": "Input",
      "sortOrder": 62
    },
    {
      "key": "-request-proto",
      "displayName": "Request Protocol",
      "parameterType": "Option",
      "dataType": "Enum",
      "description": "Protocol to use along with raw request.",
      "group": "Input",
      "sortOrder": 63,
      "enum": {
        "values": [
          {
            "value": "https",
            "displayName": "HTTPS",
            "isDefault": true,
            "sortOrder": 1
          },
          {
            "value": "http",
            "displayName": "HTTP",
            "sortOrder": 2
          }
        ]
      }
    },
    {
      "key": "-input-cmd",
      "displayName": "Input Command",
      "parameterType": "Option",
      "dataType": "String",
      "description": "Command producing the input. --input-num is required when using this method. Overrides -w.",
      "group": "Input",
      "sortOrder": 64
    },
    {
      "key": "-input-num",
      "displayName": "Input Number",
      "parameterType": "Option",
      "dataType": "Number",
      "description": "Number of inputs to test. Used in conjunction with --input-cmd.",
      "group": "Input",
      "sortOrder": 65
    },
    {
      "key": "-input-shell",
      "displayName": "Input Shell",
      "parameterType": "Option",
      "dataType": "String",
      "description": "Shell to be used for running command.",
      "group": "Input",
      "sortOrder": 66
    },
    {
      "key": "-o",
      "displayName": "Output File",
      "parameterType": "Option",
      "dataType": "String",
      "description": "Write output to file.",
      "group": "Output",
      "sortOrder": 67
    },
    {
      "key": "-of",
      "displayName": "Output Format",
      "parameterType": "Option",
      "dataType": "Enum",
      "description": "Output file format.",
      "group": "Output",
      "sortOrder": 68,
      "enum": {
        "values": [
          {
            "value": "json",
            "displayName": "JSON",
            "isDefault": true,
            "sortOrder": 1
          },
          {
            "value": "ejson",
            "displayName": "EJSON",
            "sortOrder": 2
          },
          {
            "value": "html",
            "displayName": "HTML",
            "sortOrder": 3
          },
          {
            "value": "md",
            "displayName": "Markdown",
            "sortOrder": 4
          },
          {
            "value": "csv",
            "displayName": "CSV",
            "sortOrder": 5
          },
          {
            "value": "ecsv",
            "displayName": "ECSV",
            "sortOrder": 6
          },
          {
            "value": "all",
            "displayName": "All",
            "sortOrder": 7
          }
        ]
      }
    },
    {
      "key": "-od",
      "displayName": "Output Directory",
      "parameterType": "Option",
      "dataType": "String",
      "description": "Directory path to store matched results to.",
      "group": "Output",
      "sortOrder": 69
    },
    {
      "key": "-or",
      "displayName": "No Empty Output",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "description": "Don't create the output file if we don't have results.",
      "group": "Output",
      "sortOrder": 70
    },
    {
      "key": "-debug-log",
      "displayName": "Debug Log",
      "parameterType": "Option",
      "dataType": "String",
      "description": "Write all of the internal logging to the specified file.",
      "group": "Output",
      "sortOrder": 71
    }
  ],
  "installation": {
    "sources": [
      {
        "key": "go-install",
        "method": "package_manager",
        "manager": "go",
        "command": "go install github.com/ffuf/ffuf/v2@latest",
        "url": "https://github.com/ffuf/ffuf#installation"
      },
      {
        "key": "brew",
        "method": "package_manager",
        "manager": "brew",
        "command": "brew install ffuf",
        "url": "https://github.com/ffuf/ffuf#installation",
        "os": [
          "macos"
        ]
      },
      {
        "key": "scoop",
        "method": "package_manager",
        "manager": "scoop",
        "command": "scoop install ffuf",
        "url": "https://github.com/ffuf/ffuf#installation",
        "os": [
          "windows"
        ]
      },
      {
        "key": "winget",
        "method": "package_manager",
        "manager": "winget",
        "command": "winget install ffuf.ffuf",
        "url": "https://github.com/ffuf/ffuf#installation",
        "os": [
          "windows"
        ]
      },
      {
        "key": "release-binary",
        "method": "binary",
        "command": "https://github.com/ffuf/ffuf/releases",
        "url": "https://github.com/ffuf/ffuf#installation",
        "note": "Download a prebuilt binary, unpack it and run it."
      }
    ]
  }
}
