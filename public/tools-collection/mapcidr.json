{
  "$schema": "https://commandly.divyeshio.in/specification/tool.json",
  "binaryName": "mapcidr",
  "displayName": "Mapcidr",
  "commands": [],
  "parameters": [
    {
      "key": "-cidr",
      "displayName": "CIDR input",
      "description": "CIDR, IP, or file input to process.",
      "group": "Input",
      "parameterType": "Option",
      "dataType": "String",
      "isRepeatable": true,
      "arraySeparator": ",",
      "aliases": [
        "-cl"
      ]
    },
    {
      "key": "-sbc",
      "displayName": "Slice by CIDR count",
      "description": "Split CIDRs into the requested number of subnets.",
      "group": "Process",
      "parameterType": "Option",
      "dataType": "Number"
    },
    {
      "key": "-sbh",
      "displayName": "Slice by host count",
      "description": "Split CIDRs into subnets with the requested host count.",
      "group": "Process",
      "parameterType": "Option",
      "dataType": "Number"
    },
    {
      "key": "-aggregate",
      "displayName": "Aggregate",
      "description": "Merge IPs and CIDRs into the smallest subnet.",
      "group": "Process",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "aliases": [
        "-a"
      ]
    },
    {
      "key": "-aggregate-approx",
      "displayName": "Approximate aggregate",
      "description": "Approximate sparse IPv4 ranges into the smallest subnet block.",
      "group": "Process",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "aliases": [
        "-aa"
      ]
    },
    {
      "key": "-count",
      "displayName": "Count",
      "description": "Count the number of IPs in the input CIDR.",
      "group": "Process",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "aliases": [
        "-c"
      ]
    },
    {
      "key": "-to-ipv4",
      "displayName": "Convert to IPv4",
      "description": "Convert input IPs to IPv4 format.",
      "group": "Process",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "aliases": [
        "-t4"
      ]
    },
    {
      "key": "-to-ipv6",
      "displayName": "Convert to IPv6",
      "description": "Convert input IPs to IPv6 format.",
      "group": "Process",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "aliases": [
        "-t6"
      ]
    },
    {
      "key": "-ip-format",
      "displayName": "IP format",
      "description": "Output IPs in one or more format indices.",
      "group": "Process",
      "parameterType": "Option",
      "dataType": "Enum",
      "enum": {
        "values": [
          {
            "value": "0",
            "displayName": "All formats"
          },
          {
            "value": "1",
            "displayName": "Format 1"
          },
          {
            "value": "2",
            "displayName": "Format 2"
          },
          {
            "value": "3",
            "displayName": "Format 3"
          },
          {
            "value": "4",
            "displayName": "Format 4"
          },
          {
            "value": "5",
            "displayName": "Format 5"
          },
          {
            "value": "6",
            "displayName": "Format 6"
          },
          {
            "value": "7",
            "displayName": "Format 7"
          },
          {
            "value": "8",
            "displayName": "Format 8"
          },
          {
            "value": "9",
            "displayName": "Format 9"
          },
          {
            "value": "10",
            "displayName": "Format 10"
          },
          {
            "value": "11",
            "displayName": "Format 11"
          }
        ],
        "allowMultiple": true,
        "separator": ","
      },
      "aliases": [
        "-if"
      ]
    },
    {
      "key": "-zero-pad-n",
      "displayName": "Zero pad count",
      "description": "Number of padded zeros to use.",
      "group": "Process",
      "parameterType": "Option",
      "dataType": "Number",
      "aliases": [
        "-zpn"
      ]
    },
    {
      "key": "-zero-pad-permute",
      "displayName": "Zero pad permutations",
      "description": "Enable permutations from zero to the pad count for each octet.",
      "group": "Process",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "aliases": [
        "-zpp"
      ]
    },
    {
      "key": "-filter-ipv4",
      "displayName": "Filter IPv4",
      "description": "Keep only IPv4 addresses from the input.",
      "group": "Filter",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "aliases": [
        "-f4"
      ]
    },
    {
      "key": "-filter-ipv6",
      "displayName": "Filter IPv6",
      "description": "Keep only IPv6 addresses from the input.",
      "group": "Filter",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "aliases": [
        "-f6"
      ]
    },
    {
      "key": "-skip-base",
      "displayName": "Skip base IPs",
      "description": "Skip base IPs ending in .0.",
      "group": "Filter",
      "parameterType": "Flag",
      "dataType": "Boolean"
    },
    {
      "key": "-skip-broadcast",
      "displayName": "Skip broadcast IPs",
      "description": "Skip broadcast IPs ending in .255.",
      "group": "Filter",
      "parameterType": "Flag",
      "dataType": "Boolean"
    },
    {
      "key": "-match-ip",
      "displayName": "Match IPs",
      "description": "Match IPs or CIDRs from the given list or file.",
      "group": "Filter",
      "parameterType": "Option",
      "dataType": "String",
      "isRepeatable": true,
      "arraySeparator": ",",
      "aliases": [
        "-mi"
      ]
    },
    {
      "key": "-filter-ip",
      "displayName": "Filter IPs",
      "description": "Filter IPs or CIDRs from the given list or file.",
      "group": "Filter",
      "parameterType": "Option",
      "dataType": "String",
      "isRepeatable": true,
      "arraySeparator": ",",
      "aliases": [
        "-fi"
      ]
    },
    {
      "key": "-sort",
      "displayName": "Sort ascending",
      "description": "Sort input IPs and CIDRs in ascending order.",
      "group": "Miscellaneous",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "aliases": [
        "-s"
      ]
    },
    {
      "key": "-sort-reverse",
      "displayName": "Sort descending",
      "description": "Sort input IPs and CIDRs in descending order.",
      "group": "Miscellaneous",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "aliases": [
        "-sr"
      ]
    },
    {
      "key": "-shuffle-ip",
      "displayName": "Shuffle IPs",
      "description": "Shuffle input IPs randomly.",
      "group": "Miscellaneous",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "aliases": [
        "-si"
      ]
    },
    {
      "key": "-shuffle-port",
      "displayName": "Shuffle ports",
      "description": "Shuffle input IP:Port values randomly.",
      "group": "Miscellaneous",
      "parameterType": "Option",
      "dataType": "String",
      "aliases": [
        "-sp"
      ]
    },
    {
      "key": "-update",
      "displayName": "Update",
      "description": "Update mapcidr to the latest version.",
      "group": "Update",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "aliases": [
        "-up"
      ]
    },
    {
      "key": "-disable-update-check",
      "displayName": "Disable update check",
      "description": "Disable automatic update checks.",
      "group": "Update",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "aliases": [
        "-duc"
      ]
    },
    {
      "key": "-verbose",
      "displayName": "Verbose",
      "description": "Enable verbose output.",
      "group": "Output",
      "parameterType": "Flag",
      "dataType": "Boolean"
    },
    {
      "key": "-output",
      "displayName": "Output file",
      "description": "Write output to a file.",
      "group": "Output",
      "parameterType": "Option",
      "dataType": "String",
      "aliases": [
        "-o"
      ]
    },
    {
      "key": "-silent",
      "displayName": "Silent",
      "description": "Suppress non-output logs.",
      "group": "Output",
      "parameterType": "Flag",
      "dataType": "Boolean"
    },
    {
      "key": "-version",
      "displayName": "Version",
      "description": "Show the project version.",
      "group": "Output",
      "parameterType": "Flag",
      "dataType": "Boolean"
    }
  ],
  "info": {
    "description": "Perform multiple operations on CIDR and IP ranges.",
    "version": "1.1.97",
    "url": "https://github.com/projectdiscovery/mapcidr"
  },
  "installation": {
    "sources": [
      {
        "key": "go-install",
        "method": "package_manager",
        "manager": "go",
        "command": "go install -v github.com/projectdiscovery/mapcidr/cmd/mapcidr@latest",
        "url": "https://github.com/projectdiscovery/mapcidr#installation"
      }
    ]
  }
}
