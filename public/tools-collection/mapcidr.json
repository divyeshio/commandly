{
  "$schema": "https://commandly.divyeshio.in/specification/flat.json",
  "binaryName": "mapcidr",
  "displayName": "Mapcidr",
  "commands": [],
  "parameters": [
    {
      "key": "cidr",
      "name": "CIDR input",
      "description": "CIDR, IP, or file input to process.",
      "group": "Input",
      "parameterType": "Option",
      "dataType": "String",
      "shortFlag": "-cl",
      "longFlag": "-cidr",
      "isRepeatable": true,
      "arraySeparator": ","
    },
    {
      "key": "slice-by-cidr-count",
      "name": "Slice by CIDR count",
      "description": "Split CIDRs into the requested number of subnets.",
      "group": "Process",
      "parameterType": "Option",
      "dataType": "Number",
      "shortFlag": "-sbc",
      "isRepeatable": false
    },
    {
      "key": "slice-by-host-count",
      "name": "Slice by host count",
      "description": "Split CIDRs into subnets with the requested host count.",
      "group": "Process",
      "parameterType": "Option",
      "dataType": "Number",
      "shortFlag": "-sbh",
      "isRepeatable": false
    },
    {
      "key": "aggregate",
      "name": "Aggregate",
      "description": "Merge IPs and CIDRs into the smallest subnet.",
      "group": "Process",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "shortFlag": "-a"
    },
    {
      "key": "approximate-aggregate",
      "name": "Approximate aggregate",
      "description": "Approximate sparse IPv4 ranges into the smallest subnet block.",
      "group": "Process",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "shortFlag": "-aa"
    },
    {
      "key": "count",
      "name": "Count",
      "description": "Count the number of IPs in the input CIDR.",
      "group": "Process",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "shortFlag": "-c"
    },
    {
      "key": "convert-to-ipv4",
      "name": "Convert to IPv4",
      "description": "Convert input IPs to IPv4 format.",
      "group": "Process",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "shortFlag": "-t4"
    },
    {
      "key": "convert-to-ipv6",
      "name": "Convert to IPv6",
      "description": "Convert input IPs to IPv6 format.",
      "group": "Process",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "shortFlag": "-t6"
    },
    {
      "key": "ip-format",
      "name": "IP format",
      "description": "Output IPs in one or more format indices.",
      "group": "Process",
      "parameterType": "Option",
      "dataType": "Enum",
      "shortFlag": "-if",
      "longFlag": "-ip-format",
      "enum": {
        "values": [
          {
            "value": "0",
            "displayName": "All formats"
          },
          {
            "value": "1",
            "displayName": "Format 1"
          },
          {
            "value": "2",
            "displayName": "Format 2"
          },
          {
            "value": "3",
            "displayName": "Format 3"
          },
          {
            "value": "4",
            "displayName": "Format 4"
          },
          {
            "value": "5",
            "displayName": "Format 5"
          },
          {
            "value": "6",
            "displayName": "Format 6"
          },
          {
            "value": "7",
            "displayName": "Format 7"
          },
          {
            "value": "8",
            "displayName": "Format 8"
          },
          {
            "value": "9",
            "displayName": "Format 9"
          },
          {
            "value": "10",
            "displayName": "Format 10"
          },
          {
            "value": "11",
            "displayName": "Format 11"
          }
        ],
        "allowMultiple": true,
        "separator": ","
      }
    },
    {
      "key": "zero-pad-n",
      "name": "Zero pad count",
      "description": "Number of padded zeros to use.",
      "group": "Process",
      "parameterType": "Option",
      "dataType": "Number",
      "shortFlag": "-zpn",
      "longFlag": "-zero-pad-n"
    },
    {
      "key": "zero-pad-permute",
      "name": "Zero pad permutations",
      "description": "Enable permutations from zero to the pad count for each octet.",
      "group": "Process",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "shortFlag": "-zpp",
      "longFlag": "-zero-pad-permute"
    },
    {
      "key": "filter-ipv4",
      "name": "Filter IPv4",
      "description": "Keep only IPv4 addresses from the input.",
      "group": "Filter",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "shortFlag": "-f4",
      "longFlag": "-filter-ipv4"
    },
    {
      "key": "filter-ipv6",
      "name": "Filter IPv6",
      "description": "Keep only IPv6 addresses from the input.",
      "group": "Filter",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "shortFlag": "-f6",
      "longFlag": "-filter-ipv6"
    },
    {
      "key": "skip-base",
      "name": "Skip base IPs",
      "description": "Skip base IPs ending in .0.",
      "group": "Filter",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "longFlag": "-skip-base"
    },
    {
      "key": "skip-broadcast",
      "name": "Skip broadcast IPs",
      "description": "Skip broadcast IPs ending in .255.",
      "group": "Filter",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "longFlag": "-skip-broadcast"
    },
    {
      "key": "match-ip",
      "name": "Match IPs",
      "description": "Match IPs or CIDRs from the given list or file.",
      "group": "Filter",
      "parameterType": "Option",
      "dataType": "String",
      "shortFlag": "-mi",
      "longFlag": "-match-ip",
      "isRepeatable": true,
      "arraySeparator": ","
    },
    {
      "key": "filter-ip",
      "name": "Filter IPs",
      "description": "Filter IPs or CIDRs from the given list or file.",
      "group": "Filter",
      "parameterType": "Option",
      "dataType": "String",
      "shortFlag": "-fi",
      "longFlag": "-filter-ip",
      "isRepeatable": true,
      "arraySeparator": ","
    },
    {
      "key": "sort",
      "name": "Sort ascending",
      "description": "Sort input IPs and CIDRs in ascending order.",
      "group": "Miscellaneous",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "shortFlag": "-s",
      "longFlag": "-sort"
    },
    {
      "key": "sort-reverse",
      "name": "Sort descending",
      "description": "Sort input IPs and CIDRs in descending order.",
      "group": "Miscellaneous",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "shortFlag": "-sr",
      "longFlag": "-sort-reverse"
    },
    {
      "key": "shuffle-ip",
      "name": "Shuffle IPs",
      "description": "Shuffle input IPs randomly.",
      "group": "Miscellaneous",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "shortFlag": "-si",
      "longFlag": "-shuffle-ip"
    },
    {
      "key": "shuffle-port",
      "name": "Shuffle ports",
      "description": "Shuffle input IP:Port values randomly.",
      "group": "Miscellaneous",
      "parameterType": "Option",
      "dataType": "String",
      "shortFlag": "-sp",
      "longFlag": "-shuffle-port"
    },
    {
      "key": "update",
      "name": "Update",
      "description": "Update mapcidr to the latest version.",
      "group": "Update",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "shortFlag": "-up",
      "longFlag": "-update"
    },
    {
      "key": "disable-update-check",
      "name": "Disable update check",
      "description": "Disable automatic update checks.",
      "group": "Update",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "shortFlag": "-duc",
      "longFlag": "-disable-update-check"
    },
    {
      "key": "verbose",
      "name": "Verbose",
      "description": "Enable verbose output.",
      "group": "Output",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "longFlag": "-verbose"
    },
    {
      "key": "output",
      "name": "Output file",
      "description": "Write output to a file.",
      "group": "Output",
      "parameterType": "Option",
      "dataType": "String",
      "shortFlag": "-o",
      "longFlag": "-output"
    },
    {
      "key": "silent",
      "name": "Silent",
      "description": "Suppress non-output logs.",
      "group": "Output",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "longFlag": "-silent"
    },
    {
      "key": "version",
      "name": "Version",
      "description": "Show the project version.",
      "group": "Output",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "longFlag": "-version"
    }
  ],
  "info": {
    "description": "Perform multiple operations on CIDR and IP ranges.",
    "url": "https://github.com/projectdiscovery/mapcidr"
  }
}
