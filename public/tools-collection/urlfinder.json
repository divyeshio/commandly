{
  "$schema": "https://commandly.divyeshio.in/specification/flat.json",
  "binaryName": "urlfinder",
  "displayName": "URLFinder",
  "info": {
    "description": "A streamlined tool for discovering associated URLs.",
    "version": "0.0.3",
    "url": "https://github.com/projectdiscovery/urlfinder"
  },
  "commands": [],
  "parameters": [
    {
      "name": "Domain",
      "description": "Target domain",
      "parameterType": "Option",
      "dataType": "String",
      "isRepeatable": true,
      "longFlag": "-d",
      "key": "domain"
    },
    {
      "name": "List of Domains",
      "description": "Target domain list",
      "parameterType": "Option",
      "dataType": "String",
      "isRepeatable": true,
      "longFlag": "-list",
      "arraySeparator": ",",
      "key": "list"
    },
    {
      "name": "Sources",
      "description": "Specific sources for discovery (e.g., -s alienvault,commoncrawl)",
      "parameterType": "Option",
      "dataType": "String",
      "isRepeatable": true,
      "shortFlag": "-s",
      "longFlag": "-sources",
      "arraySeparator": ",",
      "key": "sources"
    },
    {
      "name": "Exclude Sources",
      "description": "Sources to exclude (e.g., -es alienvault,commoncrawl)",
      "parameterType": "Option",
      "dataType": "String",
      "isRepeatable": true,
      "shortFlag": "-es",
      "longFlag": "-exclude-sources",
      "arraySeparator": ",",
      "key": "exclude-sources"
    },
    {
      "name": "All",
      "description": "Use all sources (may be slower)",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "longFlag": "-all",
      "key": "all"
    },
    {
      "name": "URL Scope",
      "description": "In scope url regex to be followed by urlfinder",
      "parameterType": "Option",
      "dataType": "String",
      "isRepeatable": true,
      "shortFlag": "-us",
      "longFlag": "-url-scope",
      "arraySeparator": ",",
      "key": "url-scope"
    },
    {
      "name": "URL Out Scope",
      "description": "Out of scope url regex to be excluded by urlfinder",
      "parameterType": "Option",
      "dataType": "String",
      "isRepeatable": true,
      "shortFlag": "-uos",
      "longFlag": "-url-out-scope",
      "arraySeparator": ",",
      "key": "url-out-scope"
    },
    {
      "name": "Field Scope",
      "description": "Pre-defined scope field (dn,rdn,fqdn) or custom regex (e.g., '(company-staging.io|company.com)')",
      "parameterType": "Option",
      "dataType": "String",
      "shortFlag": "-fs",
      "longFlag": "-field-scope",
      "key": "field-scope"
    },
    {
      "name": "No Scope",
      "description": "Disables host based default scope",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "shortFlag": "-ns",
      "longFlag": "-no-scope",
      "key": "no-scope"
    },
    {
      "name": "Display Out Scope",
      "description": "Display external endpoint from scoped crawling",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "shortFlag": "-do",
      "longFlag": "-display-out-scope",
      "key": "display-out-scope"
    },
    {
      "name": "Match",
      "description": "URLs or list to match (file or comma-separated)",
      "parameterType": "Option",
      "dataType": "String",
      "isRepeatable": true,
      "shortFlag": "-m",
      "longFlag": "-match",
      "arraySeparator": ",",
      "key": "match"
    },
    {
      "name": "Filter",
      "description": "URLs or list to filter (file or comma-separated)",
      "parameterType": "Option",
      "dataType": "String",
      "isRepeatable": true,
      "shortFlag": "-f",
      "longFlag": "-filter",
      "arraySeparator": ",",
      "key": "filter"
    },
    {
      "name": "Rate Limit",
      "description": "Max HTTP requests per second (global)",
      "parameterType": "Option",
      "dataType": "Number",
      "shortFlag": "-rl",
      "longFlag": "-rate-limit",
      "key": "rate-limit"
    },
    {
      "name": "Rate Limits",
      "description": "Per-provider HTTP request limits (e.g., -rls waybackarchive=15/m)",
      "parameterType": "Option",
      "dataType": "String",
      "shortFlag": "-rls",
      "longFlag": "-rate-limits",
      "key": "rate-limits"
    },
    {
      "name": "Update",
      "description": "Update URLFinder to the latest version",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "shortFlag": "-up",
      "longFlag": "-update",
      "key": "update"
    },
    {
      "name": "Verbose",
      "description": "Enable verbose output",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "shortFlag": "-v",
      "longFlag": "-verbose",
      "key": "verbose"
    },
    {
      "name": "Silent",
      "description": "Suppress output",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "shortFlag": "-s",
      "longFlag": "-silent",
      "key": "silent"
    },
    {
      "name": "Timeout",
      "description": "Timeout for HTTP requests (in seconds)",
      "parameterType": "Option",
      "dataType": "Number",
      "shortFlag": "-to",
      "longFlag": "-timeout",
      "key": "timeout"
    },
    {
      "name": "JSON Output",
      "description": "Output in JSON format",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "shortFlag": "-j",
      "longFlag": "-json",
      "key": "json"
    },
    {
      "name": "CSV Output",
      "description": "Output in CSV format",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "longFlag": "-csv",
      "key": "csv"
    },
    {
      "name": "Version",
      "description": "Display URLFinder version",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "shortFlag": "-vrs",
      "longFlag": "-version",
      "key": "version"
    }
  ]
}
