{
  "$schema": "https://commandly.divyeshio.in/specification/tool.json",
  "binaryName": "urlfinder",
  "displayName": "URLFinder",
  "info": {
    "description": "A streamlined tool for discovering associated URLs.",
    "version": "0.0.3",
    "url": "https://github.com/projectdiscovery/urlfinder"
  },
  "commands": [],
  "parameters": [
    {
      "displayName": "List of Domains",
      "description": "Target domain or list of domains",
      "parameterType": "Option",
      "dataType": "String",
      "isRepeatable": true,
      "arraySeparator": ",",
      "key": "-list",
      "aliases": [
        "-d"
      ]
    },
    {
      "displayName": "Sources",
      "description": "Specific sources for discovery (e.g., -s alienvault,commoncrawl)",
      "parameterType": "Option",
      "dataType": "String",
      "isRepeatable": true,
      "arraySeparator": ",",
      "key": "-sources",
      "aliases": [
        "-s"
      ]
    },
    {
      "displayName": "Exclude Sources",
      "description": "Sources to exclude (e.g., -es alienvault,commoncrawl)",
      "parameterType": "Option",
      "dataType": "String",
      "isRepeatable": true,
      "arraySeparator": ",",
      "key": "-exclude-sources",
      "aliases": [
        "-es"
      ]
    },
    {
      "displayName": "All",
      "description": "Use all sources (may be slower)",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-all"
    },
    {
      "displayName": "URL Scope",
      "description": "In scope url regex to be followed by urlfinder",
      "parameterType": "Option",
      "dataType": "String",
      "isRepeatable": true,
      "arraySeparator": ",",
      "key": "-url-scope",
      "aliases": [
        "-us"
      ]
    },
    {
      "displayName": "URL Out Scope",
      "description": "Out of scope url regex to be excluded by urlfinder",
      "parameterType": "Option",
      "dataType": "String",
      "isRepeatable": true,
      "arraySeparator": ",",
      "key": "-url-out-scope",
      "aliases": [
        "-uos"
      ]
    },
    {
      "displayName": "Field Scope",
      "description": "Pre-defined scope field (dn,rdn,fqdn) or custom regex (e.g., '(company-staging.io|company.com)')",
      "parameterType": "Option",
      "dataType": "String",
      "key": "-field-scope",
      "aliases": [
        "-fs"
      ]
    },
    {
      "displayName": "No Scope",
      "description": "Disables host based default scope",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-no-scope",
      "aliases": [
        "-ns"
      ]
    },
    {
      "displayName": "Display Out Scope",
      "description": "Display external endpoint from scoped crawling",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-display-out-scope",
      "aliases": [
        "-do"
      ]
    },
    {
      "displayName": "Match",
      "description": "URLs or list to match (file or comma-separated)",
      "parameterType": "Option",
      "dataType": "String",
      "isRepeatable": true,
      "arraySeparator": ",",
      "key": "-match",
      "aliases": [
        "-m"
      ]
    },
    {
      "displayName": "Filter",
      "description": "URLs or list to filter (file or comma-separated)",
      "parameterType": "Option",
      "dataType": "String",
      "isRepeatable": true,
      "arraySeparator": ",",
      "key": "-filter",
      "aliases": [
        "-f"
      ]
    },
    {
      "displayName": "Rate Limit",
      "description": "Max HTTP requests per second (global)",
      "parameterType": "Option",
      "dataType": "Number",
      "key": "-rate-limit",
      "aliases": [
        "-rl"
      ]
    },
    {
      "displayName": "Rate Limits",
      "description": "Per-provider HTTP request limits (e.g., -rls waybackarchive=15/m)",
      "parameterType": "Option",
      "dataType": "String",
      "key": "-rate-limits",
      "aliases": [
        "-rls"
      ]
    },
    {
      "displayName": "Update",
      "description": "Update URLFinder to the latest version",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-update",
      "aliases": [
        "-up"
      ]
    },
    {
      "displayName": "Verbose",
      "description": "Verbose output",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-v"
    },
    {
      "displayName": "Silent",
      "description": "Show only URLs in output",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-silent"
    },
    {
      "displayName": "Timeout",
      "description": "Timeout in seconds (default 30)",
      "parameterType": "Option",
      "dataType": "Number",
      "key": "-timeout"
    },
    {
      "displayName": "JSONL Output",
      "description": "JSONL output format",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-jsonl",
      "aliases": [
        "-j"
      ]
    },
    {
      "displayName": "Version",
      "description": "Display URLFinder version",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-version"
    },
    {
      "displayName": "Disable Update Check",
      "description": "Disable automatic update checks",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-disable-update-check",
      "aliases": [
        "-duc"
      ]
    },
    {
      "displayName": "Output File",
      "description": "Specify output file",
      "parameterType": "Option",
      "dataType": "String",
      "key": "-output",
      "aliases": [
        "-o"
      ]
    },
    {
      "displayName": "Output Directory",
      "description": "Specify output directory",
      "parameterType": "Option",
      "dataType": "String",
      "key": "-output-dir",
      "aliases": [
        "-od"
      ]
    },
    {
      "displayName": "Collect Sources",
      "description": "Include all sources in JSON output",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-collect-sources",
      "aliases": [
        "-cs"
      ]
    },
    {
      "displayName": "Config File",
      "description": "Config file path",
      "parameterType": "Option",
      "dataType": "String",
      "key": "-config"
    },
    {
      "displayName": "Provider Config File",
      "description": "Provider config file path",
      "parameterType": "Option",
      "dataType": "String",
      "key": "-provider-config",
      "aliases": [
        "-pc"
      ]
    },
    {
      "displayName": "HTTP Proxy",
      "description": "HTTP proxy to use",
      "parameterType": "Option",
      "dataType": "String",
      "key": "-proxy"
    },
    {
      "displayName": "No Color",
      "description": "Disable colored output",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-no-color",
      "aliases": [
        "-nc"
      ]
    },
    {
      "displayName": "List Sources",
      "description": "List all available sources",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-list-sources",
      "aliases": [
        "-ls"
      ]
    },
    {
      "displayName": "Stats",
      "description": "Display source statistics",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-stats"
    },
    {
      "displayName": "Max Time",
      "description": "Max time in minutes for enumeration (default 10)",
      "parameterType": "Option",
      "dataType": "Number",
      "key": "-max-time"
    }
  ],
  "installation": {
    "sources": [
      {
        "key": "go-install",
        "method": "package_manager",
        "manager": "go",
        "command": "go install -v github.com/projectdiscovery/urlfinder/cmd/urlfinder@latest",
        "url": "https://github.com/projectdiscovery/urlfinder#installation",
        "note": "Requires Go 1.21."
      },
      {
        "key": "release-binary",
        "method": "binary",
        "command": "https://github.com/projectdiscovery/urlfinder/releases",
        "url": "https://github.com/projectdiscovery/urlfinder#installation",
        "note": "Download the pre-compiled binary for your OS."
      }
    ]
  }
}
