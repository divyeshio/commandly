{
  "$schema": "https://commandly.divyeshio.in/specification/tool.json",
  "binaryName": "dnsx",
  "displayName": "DNSX",
  "info": {
    "description": "A fast and multi-purpose DNS toolkit designed for running DNS queries.",
    "version": "1.3.1",
    "url": "https://github.com/projectdiscovery/dnsx"
  },
  "commands": [],
  "parameters": [
    {
      "displayName": "List",
      "description": "List of sub(domains)/hosts to resolve (file or stdin).",
      "parameterType": "Option",
      "dataType": "String",
      "key": "-list",
      "aliases": [
        "-l"
      ]
    },
    {
      "displayName": "Domain",
      "description": "List of domain to bruteforce (file or comma separated or stdin).",
      "parameterType": "Option",
      "dataType": "String",
      "key": "-domain",
      "aliases": [
        "-d"
      ]
    },
    {
      "displayName": "Wordlist",
      "description": "List of words to bruteforce (file or comma separated or stdin).",
      "parameterType": "Option",
      "dataType": "String",
      "key": "-wordlist",
      "aliases": [
        "-w"
      ]
    },
    {
      "displayName": "A",
      "description": "Query A record (default).",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-a"
    },
    {
      "displayName": "AAAA",
      "description": "Query AAAA record.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-aaaa"
    },
    {
      "displayName": "CNAME",
      "description": "Query CNAME record.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-cname"
    },
    {
      "displayName": "NS",
      "description": "Query NS record.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-ns"
    },
    {
      "displayName": "TXT",
      "description": "Query TXT record.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-txt"
    },
    {
      "displayName": "SRV",
      "description": "Query SRV record.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-srv"
    },
    {
      "displayName": "PTR",
      "description": "Query PTR record.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-ptr"
    },
    {
      "displayName": "MX",
      "description": "Query MX record.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-mx"
    },
    {
      "displayName": "SOA",
      "description": "Query SOA record.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-soa"
    },
    {
      "displayName": "ANY",
      "description": "Query ANY record.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-any"
    },
    {
      "displayName": "AXFR",
      "description": "Query AXFR.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-axfr"
    },
    {
      "displayName": "CAA",
      "description": "Query CAA record.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-caa"
    },
    {
      "displayName": "Recon",
      "description": "Query all the DNS records (A, AAAA, CNAME, NS, TXT, SRV, PTR, MX, SOA, AXFR, CAA).",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-recon"
    },
    {
      "displayName": "Exclude Type",
      "description": "DNS query type to exclude (A, AAAA, CNAME, NS, TXT, SRV, PTR, MX, SOA, AXFR, CAA) (default none).",
      "parameterType": "Option",
      "dataType": "Enum",
      "key": "-exclude-type",
      "enum": {
        "allowMultiple": true,
        "values": [
          {
            "value": "A",
            "displayName": "A"
          },
          {
            "value": "AAAA",
            "displayName": "AAAA"
          },
          {
            "value": "CNAME",
            "displayName": "CNAME"
          },
          {
            "value": "NS",
            "displayName": "NS"
          },
          {
            "value": "TXT",
            "displayName": "TXT"
          },
          {
            "value": "SRV",
            "displayName": "SRV"
          },
          {
            "value": "PTR",
            "displayName": "PTR"
          },
          {
            "value": "MX",
            "displayName": "MX"
          },
          {
            "value": "SOA",
            "displayName": "SOA"
          },
          {
            "value": "AXFR",
            "displayName": "AXFR"
          },
          {
            "value": "CAA",
            "displayName": "CAA"
          }
        ]
      },
      "aliases": [
        "-e"
      ]
    },
    {
      "displayName": "Response",
      "description": "Display DNS response.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-resp",
      "aliases": [
        "-re"
      ]
    },
    {
      "displayName": "Response Only",
      "description": "Display DNS response only.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-resp-only",
      "aliases": [
        "-ro"
      ]
    },
    {
      "displayName": "Response Code",
      "description": "Filter result by DNS status code (e.g. -rcode noerror, servfail, refused).",
      "parameterType": "Option",
      "dataType": "String",
      "key": "-rcode",
      "aliases": [
        "-rc"
      ]
    },
    {
      "displayName": "CDN",
      "description": "Display CDN name.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-cdn"
    },
    {
      "displayName": "ASN",
      "description": "Display host ASN information.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-asn"
    },
    {
      "displayName": "Threads",
      "description": "Number of concurrent threads to use (default 100).",
      "parameterType": "Option",
      "dataType": "Number",
      "key": "-threads",
      "aliases": [
        "-t"
      ]
    },
    {
      "displayName": "Rate Limit",
      "description": "Number of DNS requests/second to make (disabled by default) (default -1).",
      "parameterType": "Option",
      "dataType": "Number",
      "key": "-rate-limit",
      "aliases": [
        "-rl"
      ]
    },
    {
      "displayName": "Update",
      "description": "Update dnsx to latest version.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-update",
      "aliases": [
        "-up"
      ]
    },
    {
      "displayName": "Disable Update Check",
      "description": "Disable automatic dnsx update check.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-disable-update-check",
      "aliases": [
        "-duc"
      ]
    },
    {
      "displayName": "Output",
      "description": "File to write output.",
      "parameterType": "Option",
      "dataType": "String",
      "key": "-output",
      "aliases": [
        "-o"
      ]
    },
    {
      "displayName": "JSON Output",
      "description": "Write output in JSONL(ines) format.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-json",
      "aliases": [
        "-j"
      ]
    },
    {
      "displayName": "Omit Raw",
      "description": "Omit raw DNS response from JSONL output.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-omit-raw",
      "aliases": [
        "-or"
      ]
    },
    {
      "displayName": "Health Check",
      "description": "Display dnsx health status.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-health-check",
      "aliases": [
        "-hc"
      ]
    },
    {
      "displayName": "Verbose",
      "description": "Show verbose output.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-verbose",
      "aliases": [
        "-v"
      ]
    },
    {
      "displayName": "No Color",
      "description": "Disable colors in CLI output.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-no-color",
      "aliases": [
        "-nc"
      ]
    },
    {
      "displayName": "Silent",
      "description": "Show only results in CLI output.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-silent"
    },
    {
      "displayName": "Version",
      "description": "Show version of dnsx.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-version"
    },
    {
      "displayName": "Output Template",
      "description": "Custom output template (e.g. -ot '{{host}} {{a}}').",
      "parameterType": "Option",
      "dataType": "String",
      "key": "-output-template",
      "aliases": [
        "-ot"
      ]
    },
    {
      "displayName": "Debug",
      "description": "Display raw DNS response.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-debug",
      "aliases": [
        "-raw"
      ]
    },
    {
      "displayName": "Stats",
      "description": "Display stats of the running scan.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-stats"
    },
    {
      "displayName": "Retry",
      "description": "Number of DNS attempts to make (must be at least 1) (default 2).",
      "parameterType": "Option",
      "dataType": "Number",
      "key": "-retry"
    },
    {
      "displayName": "Hosts File",
      "description": "Use system host file.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-hostsfile",
      "aliases": [
        "-hf"
      ]
    },
    {
      "displayName": "Trace",
      "description": "Perform DNS tracing.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-trace"
    },
    {
      "displayName": "Trace Max Recursion",
      "description": "Max recursion for DNS trace (default 32767).",
      "parameterType": "Option",
      "dataType": "Number",
      "key": "-trace-max-recursion"
    },
    {
      "displayName": "Resume",
      "description": "Resume existing scan.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-resume"
    },
    {
      "displayName": "Stream",
      "description": "Stream mode (wordlist, wildcard, stats and stop/resume will be disabled).",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-stream"
    },
    {
      "displayName": "Timeout",
      "description": "Maximum time to wait for a DNS query to complete (default 3s).",
      "parameterType": "Option",
      "dataType": "String",
      "key": "-timeout"
    },
    {
      "displayName": "Auth",
      "description": "Configure ProjectDiscovery Cloud (PDCP) API key.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-auth"
    },
    {
      "displayName": "Resolver",
      "description": "List of resolvers to use (file or comma separated).",
      "parameterType": "Option",
      "dataType": "String",
      "key": "-resolver",
      "aliases": [
        "-r"
      ]
    },
    {
      "displayName": "Wildcard Threshold",
      "description": "Wildcard filter threshold (default 5).",
      "parameterType": "Option",
      "dataType": "Number",
      "key": "-wildcard-threshold",
      "aliases": [
        "-wt"
      ]
    },
    {
      "displayName": "Auto Wildcard",
      "description": "Automatically detect wildcard domains for filtering.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "key": "-auto-wildcard"
    },
    {
      "displayName": "Wildcard Domain",
      "description": "Domain name for manual wildcard filtering.",
      "parameterType": "Option",
      "dataType": "String",
      "key": "-wildcard-domain",
      "aliases": [
        "-wd"
      ]
    }
  ],
  "installation": {
    "sources": [
      {
        "key": "go-install",
        "method": "package_manager",
        "manager": "go",
        "command": "go install -v github.com/projectdiscovery/dnsx/cmd/dnsx@latest",
        "url": "https://docs.projectdiscovery.io/opensource/dnsx/install"
      },
      {
        "key": "brew",
        "method": "package_manager",
        "manager": "brew",
        "command": "brew install dnsx",
        "url": "https://docs.projectdiscovery.io/opensource/dnsx/install",
        "os": [
          "linux",
          "macos"
        ]
      },
      {
        "key": "docker",
        "method": "docker",
        "command": "docker pull projectdiscovery/dnsx:latest",
        "url": "https://docs.projectdiscovery.io/opensource/dnsx/install"
      },
      {
        "key": "release-binary",
        "method": "binary",
        "command": "https://github.com/projectdiscovery/dnsx/releases",
        "url": "https://docs.projectdiscovery.io/opensource/dnsx/install",
        "note": "Download the latest binary for your OS and unzip it."
      }
    ]
  }
}
