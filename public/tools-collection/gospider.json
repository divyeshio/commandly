{
  "$schema": "https://commandly.divyeshio.in/specification/tool.json",
  "binaryName": "gospider",
  "displayName": "GoSpider",
  "info": {
    "description": "Fast web spider written in Go.",
    "version": "1.1.6",
    "url": "https://github.com/jaeles-project/gospider"
  },
  "commands": [],
  "parameters": [
    {
      "displayName": "Site",
      "description": "Site to crawl.",
      "parameterType": "Option",
      "dataType": "String",
      "sortOrder": 1,
      "key": "--site",
      "aliases": [
        "-s"
      ]
    },
    {
      "displayName": "Sites",
      "description": "Site list to crawl.",
      "parameterType": "Option",
      "dataType": "String",
      "sortOrder": 2,
      "key": "--sites",
      "aliases": [
        "-S"
      ]
    },
    {
      "displayName": "Proxy",
      "description": "Proxy (ex: http://127.0.0.1:8080).",
      "parameterType": "Option",
      "dataType": "String",
      "sortOrder": 3,
      "key": "--proxy",
      "aliases": [
        "-p"
      ]
    },
    {
      "displayName": "Output",
      "description": "Output folder.",
      "parameterType": "Option",
      "dataType": "String",
      "sortOrder": 4,
      "key": "--output",
      "aliases": [
        "-o"
      ]
    },
    {
      "displayName": "User Agent",
      "description": "User agent to use.",
      "parameterType": "Option",
      "dataType": "String",
      "sortOrder": 5,
      "key": "--user-agent",
      "aliases": [
        "-u"
      ]
    },
    {
      "displayName": "Cookie",
      "description": "Cookie to use (testA=a; testB=b).",
      "parameterType": "Option",
      "dataType": "String",
      "sortOrder": 6,
      "key": "--cookie"
    },
    {
      "displayName": "Header",
      "description": "Header to use. Use multiple flag to set multiple headers.",
      "parameterType": "Option",
      "dataType": "String",
      "isRepeatable": true,
      "sortOrder": 7,
      "key": "--header",
      "aliases": [
        "-H"
      ]
    },
    {
      "displayName": "Burp",
      "description": "Load headers and cookie from burp raw http request.",
      "parameterType": "Option",
      "dataType": "String",
      "sortOrder": 8,
      "key": "--burp"
    },
    {
      "displayName": "Blacklist",
      "description": "Blacklist URL regex.",
      "parameterType": "Option",
      "dataType": "String",
      "sortOrder": 9,
      "key": "--blacklist"
    },
    {
      "displayName": "Whitelist",
      "description": "Whitelist URL regex.",
      "parameterType": "Option",
      "dataType": "String",
      "sortOrder": 10,
      "key": "--whitelist"
    },
    {
      "displayName": "Whitelist Domain",
      "description": "Whitelist domain.",
      "parameterType": "Option",
      "dataType": "String",
      "sortOrder": 11,
      "key": "--whitelist-domain"
    },
    {
      "displayName": "Threads",
      "description": "Number of threads (run sites in parallel).",
      "parameterType": "Option",
      "dataType": "Number",
      "sortOrder": 12,
      "key": "--threads",
      "aliases": [
        "-t"
      ]
    },
    {
      "displayName": "Concurrent",
      "description": "The number of the maximum allowed concurrent requests of the matching domains.",
      "parameterType": "Option",
      "dataType": "Number",
      "sortOrder": 13,
      "key": "--concurrent",
      "aliases": [
        "-c"
      ]
    },
    {
      "displayName": "Depth",
      "description": "MaxDepth limits the recursion depth of visited URLs. Set it to 0 for infinite recursion.",
      "parameterType": "Option",
      "dataType": "Number",
      "sortOrder": 14,
      "key": "--depth",
      "aliases": [
        "-d"
      ]
    },
    {
      "displayName": "Delay",
      "description": "Duration to wait before creating a new request to the matching domains (seconds).",
      "parameterType": "Option",
      "dataType": "Number",
      "sortOrder": 15,
      "key": "--delay",
      "aliases": [
        "-k"
      ]
    },
    {
      "displayName": "Random Delay",
      "description": "Extra randomized duration to wait added to delay before creating a new request (seconds).",
      "parameterType": "Option",
      "dataType": "Number",
      "sortOrder": 16,
      "key": "--random-delay",
      "aliases": [
        "-K"
      ]
    },
    {
      "displayName": "Timeout",
      "description": "Request timeout (seconds).",
      "parameterType": "Option",
      "dataType": "Number",
      "sortOrder": 17,
      "key": "--timeout",
      "aliases": [
        "-m"
      ]
    },
    {
      "displayName": "Base",
      "description": "Disable all and only use HTML content.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 18,
      "key": "--base"
    },
    {
      "displayName": "JavaScript",
      "description": "Enable linkfinder in javascript file.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 19,
      "key": "--js"
    },
    {
      "displayName": "Include Subdomains",
      "description": "Include subdomains.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 20,
      "key": "--subs"
    },
    {
      "displayName": "Sitemap",
      "description": "Try to crawl sitemap.xml.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 21,
      "key": "--sitemap"
    },
    {
      "displayName": "Robots",
      "description": "Try to crawl robots.txt.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 22,
      "key": "--robots"
    },
    {
      "displayName": "Other Source",
      "description": "Find URLs from third-party sources (Archive.org, CommonCrawl.org, VirusTotal.com, AlienVault.com).",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 23,
      "key": "--other-source",
      "aliases": [
        "-a"
      ]
    },
    {
      "displayName": "Include Third-Party Subdomains",
      "description": "Include subdomains crawled from third-party sources. Default is main domain.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 24,
      "key": "--include-subs",
      "aliases": [
        "-w"
      ]
    },
    {
      "displayName": "Include Other Source URLs",
      "description": "Also include other-source URLs (still crawl and request).",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 25,
      "key": "--include-other-source",
      "aliases": [
        "-r"
      ]
    },
    {
      "displayName": "Debug",
      "description": "Turn on debug mode.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 26,
      "key": "--debug"
    },
    {
      "displayName": "JSON Output",
      "description": "Enable JSON output.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 27,
      "key": "--json"
    },
    {
      "displayName": "Verbose",
      "description": "Turn on verbose.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 28,
      "key": "--verbose",
      "aliases": [
        "-v"
      ]
    },
    {
      "displayName": "Length",
      "description": "Turn on length.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 29,
      "key": "--length",
      "aliases": [
        "-l"
      ]
    },
    {
      "displayName": "Filter Length",
      "description": "Turn on length filter.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 30,
      "key": "--filter-length",
      "aliases": [
        "-L"
      ]
    },
    {
      "displayName": "Raw",
      "description": "Turn on raw.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 31,
      "key": "--raw",
      "aliases": [
        "-R"
      ]
    },
    {
      "displayName": "Quiet",
      "description": "Suppress all the output and only show URL.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 32,
      "key": "--quiet",
      "aliases": [
        "-q"
      ]
    },
    {
      "displayName": "No Redirect",
      "description": "Disable redirect.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 33,
      "key": "--no-redirect"
    },
    {
      "displayName": "Version",
      "description": "Check version.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 34,
      "key": "--version"
    },
    {
      "displayName": "Help",
      "description": "Help for gospider.",
      "parameterType": "Flag",
      "dataType": "Boolean",
      "sortOrder": 35,
      "key": "--help",
      "aliases": [
        "-h"
      ]
    }
  ],
  "installation": {
    "sources": [
      {
        "key": "go-install",
        "method": "package_manager",
        "manager": "go",
        "command": "GO111MODULE=on go install github.com/jaeles-project/gospider@latest",
        "url": "https://github.com/jaeles-project/gospider#installation"
      },
      {
        "key": "docker",
        "method": "docker",
        "command": "git clone https://github.com/jaeles-project/gospider.git\ndocker build -t gospider:latest gospider\ndocker run -t gospider -h",
        "url": "https://github.com/jaeles-project/gospider#installation"
      }
    ]
  }
}
